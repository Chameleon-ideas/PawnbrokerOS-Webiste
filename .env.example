# --------------------------------------------------------------------------
# HubSpot — Book a Demo form
#
# Copy this file to `.env` and fill in the values from HubSpot.
# Find them in HubSpot: Marketing > Lead Capture > Forms > (your form) >
# Share > Embed code. The snippet contains all three values:
#
#   hbspt.forms.create({
#     region: "na1",                                   <- PUBLIC_HUBSPOT_REGION
#     portalId: "12345678",                            <- PUBLIC_HUBSPOT_PORTAL_ID
#     formId: "a1b2c3d4-0000-0000-0000-abcdef123456"   <- PUBLIC_HUBSPOT_FORM_ID
#   });
#
# These are not secrets — they are public in any HubSpot embed code.
# The PUBLIC_ prefix is required for Astro to expose them to the browser.
# --------------------------------------------------------------------------

PUBLIC_HUBSPOT_PORTAL_ID=
PUBLIC_HUBSPOT_FORM_ID=
PUBLIC_HUBSPOT_REGION=na1

# Optional: internal name of a HubSpot property that records which pricing
# plan the visitor clicked from. Leave as-is if you have not created one.
PUBLIC_HUBSPOT_PLAN_FIELD=plan_interest

# Optional: fallback contact address shown if scheduling fails or for direct email inquiries.
PUBLIC_SALES_EMAIL=sales@pawndesk.app

# --------------------------------------------------------------------------
# Calendly — Schedule a Demo
#
# Replace with your live Calendly event link when ready:
# --------------------------------------------------------------------------
PUBLIC_CALENDLY_URL=https://calendly.com/your-team/pawndesk-demo
