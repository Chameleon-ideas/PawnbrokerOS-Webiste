---
import Icon from './Icon.astro';
import DemoCard from './DemoCard.astro';

const steps = [
  {
    icon: 'calendar',
    title: 'Pick a time that suits your counter',
    body: 'Select a slot when your store is quiet. We work around your busy rush, not ours.',
  },
  {
    icon: 'users',
    title: 'A 30-minute walkthrough on your terms',
    body: 'A specialist shows you active loans, inventory lookups, layaway payments, and till reconciliations.',
  },
  {
    icon: 'file-text',
    title: 'Get a clear transition outline',
    body: 'We explain how your current paper tickets or spreadsheets map into PawnbrokerOS with zero downtime.',
  },
];

const assurances = [
  'No credit card required',
  'Free migration guidance',
  'Answered by pawn specialists',
];

const details = [
  { icon: 'calendar', label: '30 minutes', note: 'Live interactive screen share' },
  { icon: 'users', label: '1-on-1 session', note: 'Questions tailored to your exact store setup' },
  { icon: 'shield', label: 'Zero commitment', note: 'No credit card needed, no pushy sales scripts' },
];
---

<section class="section demo" id="book-demo" aria-labelledby="book-demo-title">
  <div class="demo__wash" aria-hidden="true"></div>

  <div class="container demo__inner">
    <!-- Left Column: Context & Steps -->
    <div class="demo__copy" data-reveal-group="90">
      <span class="eyebrow eyebrow--bordered demo__eyebrow" data-reveal>
        <i class="dot"></i>Schedule a Demo
      </span>

      <h2 class="h-section demo__h" id="book-demo-title" data-reveal>See PawnbrokerOS running your shop.</h2>

      <p class="lede demo__lede" data-reveal>
        Thirty minutes, screen to screen. Bring your messiest loan, your custom layaway scenario, or the
        report your accountant keeps asking for, and we will show you how PawnbrokerOS handles it live.
      </p>

      <ol class="demo__steps" data-reveal>
        {
          steps.map((s, i) => (
            <li class="demo__step">
              <span class="demo__step-ico">
                <Icon name={s.icon} size={20} />
              </span>
              <div class="demo__step-txt">
                <span class="demo__step-num">Step {String(i + 1).padStart(2, '0')}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <ul class="demo__assure" data-reveal>
        {
          assurances.map((a) => (
            <li>
              <span class="demo__assure-tick">
                <Icon name="check" size={12} stroke={3} />
              </span>
              {a}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right Column: Calendly Trigger Card -->
    <div class="demo__action-col" data-reveal>
      <DemoCard />
    </div>
  </div>
</section>

<style>
  /* ========================================================================
     Section shell — keeps the global .section gutter, adds a soft violet wash
     ======================================================================== */
  .demo {
    position: relative;
    isolation: isolate;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .demo__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 55% at 12% 0%, rgb(124 58 237 / 0.1) 0%, transparent 62%),
      radial-gradient(52% 60% at 92% 96%, rgb(96 93 236 / 0.09) 0%, transparent 60%),
      linear-gradient(170deg, #faf9ff 0%, #f3f0ff 52%, #f8f7ff 100%);
  }

  .demo__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 452px);
    gap: 72px;
    align-items: start;
  }

  /* ------------------------------- Left column ------------------------------ */
  .demo__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .demo__eyebrow {
    background: rgb(255 255 255 / 0.72);
    color: var(--primary-700);
    backdrop-filter: blur(4px);
  }

  .demo__h {
    margin-top: 22px;
    max-width: 540px;
    font-size: 46px;
    line-height: 1.14;
    letter-spacing: -0.5px;
  }

  .demo__lede {
    margin-top: 18px;
    max-width: 52ch;
    color: var(--body);
  }

  /* Timeline list -------------------------------------------------------- */
  .demo__steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 44px;
    max-width: 540px;
    width: 100%;
  }

  .demo__step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  /* Connector drawn per step so it stops at the last icon instead of dangling */
  .demo__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 55px;
    bottom: -28px;
    left: 23px;
    width: 1px;
    background: linear-gradient(to bottom, var(--border-violet-2), rgb(196 181 253 / 0.35));
  }

  .demo__step-ico {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex: none;
    width: 47px;
    height: 47px;
    border-radius: var(--r-pill);
    background: #fff;
    border: 1px solid var(--border-violet);
    box-shadow: 0 2px 6px rgb(76 29 149 / 0.07);
    color: var(--primary);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .demo__step:hover .demo__step-ico {
    transform: translateY(-2px);
    border-color: var(--primary);
    box-shadow: 0 10px 20px -10px rgb(96 93 236 / 0.8);
  }

  .demo__step-txt {
    padding-top: 2px;
  }

  .demo__step-num {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--primary);
    opacity: 0.75;
  }

  .demo__step-txt h3 {
    margin-top: 5px;
    font-size: 16.5px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink-800);
  }

  .demo__step-txt p {
    margin-top: 6px;
    max-width: 46ch;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Assurance chips ------------------------------------------------------ */
  .demo__assure {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    max-width: 540px;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--border-violet);
  }

  .demo__assure li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px 8px 10px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.75);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-700);
  }

  .demo__assure-tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: var(--r-pill);
    background: var(--green-bg);
    color: var(--green-fg);
  }

  /* ------------------------------ Right column ------------------------------ */
  .demo__action-col {
    position: sticky;
    top: 104px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* -------------------------------- Responsive ------------------------------- */
  @media (max-width: 1100px) {
    .demo__inner {
      gap: 52px;
    }
    .demo__h {
      font-size: 38px;
    }
    .demo__action-col {
      top: 92px;
    }
  }

  @media (max-width: 980px) {
    .demo__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      justify-items: stretch;
    }
    .demo__copy,
    .demo__steps,
    .demo__assure {
      max-width: none;
    }
    .demo__action-col {
      position: static;
      max-width: 520px;
      width: 100%;
    }
  }

  @media (max-width: 760px) {
    .demo__h {
      font-size: 31px;
      line-height: 1.18;
      max-width: none;
    }
    .demo__steps {
      gap: 24px;
      margin-top: 36px;
    }
    .demo__step {
      gap: 16px;
    }
    .demo__step-ico {
      width: 42px;
      height: 42px;
    }
    .demo__step:not(:last-child)::before {
      top: 50px;
      bottom: -24px;
      left: 20.5px;
    }
    .demo__assure {
      margin-top: 32px;
      padding-top: 24px;
    }
  }

</style>
