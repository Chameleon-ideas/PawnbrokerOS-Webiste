---
import Icon from './Icon.astro';
import Scaler from './mockups/Scaler.astro';
import BrowserBar from './mockups/BrowserBar.astro';
import AppNav from './mockups/AppNav.astro';

const rows = [
  { id: '08104372', n: 'Acevedo, Maria',   p: '(786) 555-8142', l: '3', v: '02/14/24', f: { t: 'VIP', c: 'amber' } },
  { id: '08104221', n: 'Brennan, Tom',     p: '(786) 555-8271', l: '3', v: '02/14/24', f: null },
  { id: '08103031', n: 'Daniels, Frank',   p: '(786) 555-1289', l: '4', v: '02/23/24', f: { t: 'Active', c: 'green' } },
  { id: '08103379', n: 'Hatfield, Beverly',p: '(786) 555-7962', l: '-', v: '12/04/18', f: { t: 'DO NOT LOAN', c: 'red' } },
  { id: '08103762', n: 'Esposito, Rosa',   p: '(786) 555-9965', l: '-', v: '02/14/24', f: null },
];

const cards = [
  {
    icon: 'user', bg: 'var(--lilac-50)', fg: 'var(--primary)',
    t: 'Rich Customer Profiles',
    d: 'Name, contact details, date of birth, and ID documents captured at first visit and carried through every future transaction. No re-entering. No asking twice.',
  },
  {
    icon: 'alert-triangle', bg: 'var(--red-bg)', fg: 'var(--red-fg)',
    t: 'Customer Flags & Alerts',
    d: 'Mark customers as VIP, repeat, or do-not-loan with visible or internal notes. Staff see the flag the moment they pull up the profile before the transaction starts, not after.',
  },
  {
    icon: 'search', bg: 'var(--green-bg)', fg: 'var(--green-fg)',
    t: 'Powerful Search & Filters',
    d: "Find any customer instantly by name, phone number, ID number, or any detail on file. The longer a customer's history, the more useful their record becomes.",
  },
];
---

<section class="section cs">
  <div class="container">
    <div class="sec-head" data-reveal>
      <span class="eyebrow">Every Customer, One Search Away</span>
      <h2 class="h-section" style="max-width:680px">Full Customer Profiles That Follow Every Transaction.</h2>
      <p class="lede" style="max-width:580px;color:var(--body)">
        Personal details, ID documents, account flags, and a complete history of every loan, payment,
        buy, and sale all tied to one record. Staff pull it up once and everything is there before the
        customer finishes their sentence.
      </p>
    </div>

    <div class="cs__visual" data-reveal>
      <Scaler width={1280}>
        <div class="mock" style="width:1280px;box-shadow:var(--sh-lg)">
          <BrowserBar url="dashboard.pawnbrokeros.com / customers" padding="12px 16px" dot={10} urlWidth={400} font={11} />
          <AppNav
            tabs={['Customer', 'Pawn/Loan', 'Purchase', 'Sale', 'Reports', 'Settings']}
            active="Customer" height={44} padding="0 20px" gap={24} userName
          />

          <div class="cs__ph">
            <div>
              <h3>Customers</h3>
              <p>All customers · 4,288 records</p>
            </div>
            <div class="cs__pha">
              <span class="pill-btn" style="padding:6px 10px;font-size:11px">Import</span>
              <span class="pill-btn" style="padding:6px 10px;font-size:11px">Export</span>
              <span class="pill-btn pill-btn--solid" style="padding:6px 12px;font-size:11px">New Customer</span>
            </div>
          </div>

          <div class="cs__body">
            <div class="cs__stats">
              <div class="stat" style="padding:14px">
                <span class="stat__k">Customers</span>
                <div><div class="stat__v" style="font-size:22px">4,288</div><div class="stat__u" style="font-size:11px">total</div></div>
              </div>
              <div class="stat" style="padding:14px">
                <span class="stat__k">With Active Loan</span>
                <div><div class="stat__v" style="font-size:22px">938</div><div class="stat__u" style="font-size:11px">customers</div></div>
              </div>
              <div class="stat" style="padding:14px">
                <span class="stat__k">Banned / Locked</span>
                <div><div class="stat__v" style="font-size:22px">77</div><div class="stat__u" style="font-size:11px">do-not-loan flag</div></div>
              </div>
            </div>

            <div class="cs__filters">
              <div class="fld" style="flex:1">
                <span class="fld__l">Search customers</span>
                <span class="fld__c" style="height:32px;font-size:11px"><Icon name="search" size={12} /><span class="ph">Name, phone, ID #, email, last 4 SSN</span></span>
              </div>
              <div class="fld" style="width:140px">
                <span class="fld__l">Has Active Loan</span>
                <span class="fld__c" style="height:32px;font-size:11px">Any<Icon name="chevron-down" size={10} class="sp" /></span>
              </div>
              <div class="fld" style="width:140px">
                <span class="fld__l">Banned / Locked</span>
                <span class="fld__c" style="height:32px;font-size:11px">Any<Icon name="chevron-down" size={10} class="sp" /></span>
              </div>
              <div class="fld" style="width:140px">
                <span class="fld__l">Last Visit</span>
                <span class="fld__c" style="height:32px;font-size:11px">Any time<Icon name="chevron-down" size={10} class="sp" /></span>
              </div>
            </div>

            <div class="cs__table">
              <table class="tbl">
                <thead>
                  <tr>
                    <th style="width:40px"><span class="cbx"></span></th>
                    <th style="width:110px">CUSTOMER #</th>
                    <th>NAME</th>
                    <th style="width:150px">PHONE</th>
                    <th style="width:110px" class="num">ACTIVE LOANS</th>
                    <th style="width:100px">LAST VISIT</th>
                    <th style="width:160px">FLAGS</th>
                    <th style="width:80px" class="num">ACTION</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr>
                      <td><span class="cbx"></span></td>
                      <td class="dim">{r.id}</td>
                      <td class="name">{r.n}</td>
                      <td>{r.p}</td>
                      <td class="num"><b>{r.l}</b></td>
                      <td>{r.v}</td>
                      <td>{r.f ? <span class={`chip chip--${r.f.c}`}>{r.f.t}</span> : <span class="dim">-</span>}</td>
                      <td class="num"><span class="open">Open<Icon name="chevron-right" size={10} /></span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <div class="pager" style="padding:8px 14px;font-size:10px;border-top:1px solid var(--border)">
                <span>Showing 8 of 4,288 records</span>
                <span>Page 1 of 12</span>
                <span class="pager__btns"><span style="padding:4px 8px;font-size:10px">Prev</span><span style="padding:4px 8px;font-size:10px">Next</span></span>
              </div>
            </div>
          </div>
        </div>
      </Scaler>
    </div>

    <div class="cs__cards" data-reveal-group="80">
      {
        cards.map((c) => (
          <article class="csc" data-reveal>
            <span class="csc__ico" style={`background:${c.bg};color:${c.fg}`}><Icon name={c.icon} size={22} /></span>
            <div>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cs { background: #fff; }
  .cs .sec-head { margin-bottom: 64px; }
  .cs__visual { margin-bottom: 28px; }

  .cs__ph {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px; background: #fff; border-bottom: 1px solid var(--border);
  }
  .cs__ph h3 { font-size: 20px; font-weight: 700; color: var(--ink-700); }
  .cs__ph p { font-size: 12px; color: var(--muted-2); margin-top: 3px; }
  .cs__pha { display: flex; align-items: center; gap: 6px; }

  .cs__body { display: flex; flex-direction: column; gap: 16px; padding: 20px; background: #fff; }
  .cs__stats { display: flex; gap: 12px; }
  .cs__stats :global(.stat__k) { font-size: 9px; }

  .cs__filters {
    display: flex; align-items: flex-end; gap: 10px;
    padding: 12px 16px;
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
  }
  .cs__filters :global(.fld__l) { font-size: 9px; }

  .cs__table {
    border: 1px solid var(--border); border-radius: var(--r-10);
    box-shadow: var(--sh-sm); overflow: hidden;
  }
  .cs__table :global(.tbl th) { padding: 8px 12px; }
  .cs__table :global(.tbl thead th:first-child) { padding: 8px 10px; }
  .cs__table :global(.tbl tbody td:first-child) { padding: 9px 10px; }

  .cbx { display: inline-block; width: 12px; height: 12px; background: #fff; border: 1px solid var(--border-violet); border-radius: 3px; }
  .open {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 11px; font-weight: 700; color: var(--grey-700);
    transition: color .2s var(--ease), gap .2s var(--ease);
  }
  tr:hover .open { color: var(--primary); gap: 6px; }

  /* bottom cards */
  .cs__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .csc {
    display: flex; flex-direction: column; gap: 16px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--grey-200);
    border-radius: var(--r-12);
    box-shadow: 0 2px 8px rgb(0 0 0 / .05);
    transition: transform .35s var(--ease), box-shadow .35s var(--ease);
  }
  .csc:hover { transform: translateY(-6px); box-shadow: 0 18px 34px -20px rgb(76 29 149 / .4); }
  .csc__ico {
    display: grid; place-items: center;
    width: 44px; height: 44px; border-radius: var(--r-10);
    transition: transform .35s var(--ease);
  }
  .csc:hover .csc__ico { transform: scale(1.08) rotate(-4deg); }
  .csc h3 { font-size: 15px; font-weight: 700; color: #111827; margin-bottom: 8px; }
  .csc p { font-size: 14px; line-height: 22px; color: var(--muted-2); }

  @media (max-width: 1000px) { .cs__cards { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .cs .sec-head { margin-bottom: 40px; }
    .csc { padding: 20px; }
  }
</style>
