---
import Icon from './Icon.astro';

/* Source: "PawnbrokerOS vs PawnMate, Bravo & PawnSnap — Feature Comparison
   (Website Update)", 26 Nov 2026 — the "What only PawnbrokerOS offers" list.
   Every claim here is a row the brief marks Yes (built and live). Nothing
   marked Partly or Coming soon appears: card terminals, online payment, direct
   accounting/marketplace sync and the native customer app are deliberately out.

   The brief wants legal sign-off before naming competitors and offers "other
   pawn software" as the approved alternative — hence the generic `vs` line on
   each tile and the sourcing note under the grid. */
---

<section class="section dx" id="why-pawnbrokeros">
  <div class="container">
    <div class="sec-head dx__head" data-reveal>
      <span class="eyebrow eyebrow--bordered"><span class="dot"></span>What Sets Us Apart</span>
      <h2 class="h-section" style="max-width:820px">Five Things Only PawnbrokerOS Does</h2>
      <p class="lede" style="max-width:640px">
        Every pawn system covers the daily counter, and so does ours — pawns, buys, sales, layaway,
        inventory and till. These five are the ones you will not find together anywhere else.
      </p>
    </div>

    <div class="dx__grid" data-reveal-group="80">
      <!-- 1 ─ Offline. The hero tile: the counter keeps writing, then syncs. -->
      <article class="dx__tile dx__tile--wide" data-reveal>
        <div class="dx__viz">
          <div class="vo">
            <div class="vo__bar">
              <span class="vo__dot"></span>
              <span class="vo__state vo__state--off">Internet down</span>
              <span class="vo__state vo__state--on">Back online — 3 synced</span>
            </div>
            <ul class="vo__lines">
              <li><i><Icon name="check" size={10} stroke={4} /></i>Pawn #4821 written</li>
              <li><i><Icon name="check" size={10} stroke={4} /></i>Payment $140 taken</li>
              <li><i><Icon name="check" size={10} stroke={4} /></i>Sale #2290 rung</li>
            </ul>
          </div>
        </div>
        <div class="dx__body">
          <span class="dx__ico"><Icon name="wifi-off" size={18} /></span>
          <h3>Keeps trading through an internet outage</h3>
          <p>
            The counter keeps writing pawns and taking payments with the line down, then syncs
            everything the moment it is back. No paper fallback, no lost tickets.
          </p>
        </div>
        <p class="dx__vs"><span>Other pawn software</span>Advertised as cloud-only.</p>
      </article>

      <!-- 2 ─ Both countries in one product. -->
      <article class="dx__tile" data-reveal>
        <div class="dx__viz">
          <div class="vf">
            <span class="vf__badge">CA</span>
            <span class="vf__plus"><Icon name="plus" size={13} stroke={3} /></span>
            <span class="vf__badge">US</span>
          </div>
          <div class="vf__chips">
            <span>FINTRAC</span><span>FinCEN</span><span>Sanctions</span><span>Provincial &amp; state tax</span>
          </div>
        </div>
        <div class="dx__body">
          <span class="dx__ico"><Icon name="globe" size={18} /></span>
          <h3>Canada and the US in one product</h3>
          <p>Large-cash reporting, sanctions lists and tax for both countries — no separate edition.</p>
        </div>
        <p class="dx__vs"><span>Other pawn software</span>US-focused; Canadian reporting not listed.</p>
      </article>

      <!-- 3 ─ Compliance in the base plan. -->
      <article class="dx__tile" data-reveal>
        <div class="dx__viz">
          <ul class="vc">
            <li><i><Icon name="check" size={10} stroke={4} /></i>Form 8300</li>
            <li><i><Icon name="check" size={10} stroke={4} /></i>FINTRAC large-cash</li>
            <li><i><Icon name="check" size={10} stroke={4} /></i>Sanctions, re-checked nightly</li>
            <li><i><Icon name="check" size={10} stroke={4} /></i>Voided-activity reports</li>
            <li><i><Icon name="check" size={10} stroke={4} /></i>US firearm reports</li>
          </ul>
          <p class="vc__foot">All in the base plan — $0 extra</p>
        </div>
        <div class="dx__body">
          <span class="dx__ico"><Icon name="shield" size={18} /></span>
          <h3>Compliance included, never an add-on</h3>
          <p>The reports your inspector asks for ship with the product, not with an upgrade invoice.</p>
        </div>
        <p class="dx__vs"><span>Other pawn software</span>Usually a separate, paid module.</p>
      </article>

      <!-- 4 ─ Owner app and customer page. -->
      <article class="dx__tile" data-reveal>
        <div class="dx__viz">
          <div class="vd">
            <div class="vd__win">
              <span class="vd__chrome"><i></i><i></i><i></i></span>
              <span class="vd__l" style="width:72%"></span>
              <span class="vd__l" style="width:88%"></span>
              <span class="vd__l" style="width:54%"></span>
              <span class="vd__tag">Customer page</span>
            </div>
            <div class="vd__phone">
              <span class="vd__notch"></span>
              <span class="vd__fig">$8,420</span>
              <span class="vd__l" style="width:80%"></span>
              <span class="vd__l" style="width:60%"></span>
              <span class="vd__tag">Owner app</span>
            </div>
          </div>
        </div>
        <div class="dx__body">
          <span class="dx__ico"><Icon name="smartphone" size={18} /></span>
          <h3>An owner app and a customer page</h3>
          <p>
            Your numbers on your phone off-site; their pawns, renew and redeem amounts and your
            stock on theirs.
          </p>
        </div>
        <p class="dx__vs"><span>Other pawn software</span>No feature page we reviewed lists both.</p>
      </article>

      <!-- 5 ─ Live metal rates. -->
      <article class="dx__tile" data-reveal>
        <div class="dx__viz">
          <div class="vm">
            <span class="vm__live"><i></i>Live</span>
            <div class="vm__row">
              <span class="vm__k"><i class="vm__sw vm__sw--g"></i>Gold</span>
              <b>$3,412.80</b><span class="vm__u">/oz</span>
            </div>
            <div class="vm__row">
              <span class="vm__k"><i class="vm__sw vm__sw--s"></i>Silver</span>
              <b>$41.26</b><span class="vm__u">/oz</span>
            </div>
            <svg class="vm__spark" viewBox="0 0 180 38" fill="none" aria-hidden="true">
              <path d="M2 30 L24 25 L46 28 L68 17 L90 21 L112 11 L134 14 L158 5 L178 8"
                stroke="#fbbf24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M2 34 L24 32 L46 33 L68 28 L90 30 L112 24 L134 26 L158 20 L178 22"
                stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                opacity=".65" />
            </svg>
          </div>
        </div>
        <div class="dx__body">
          <span class="dx__ico"><Icon name="coins" size={18} /></span>
          <h3>Live gold and silver on every screen</h3>
          <p>Spot prices run straight through the scrap and refiner tools, so a quote uses today's price.</p>
        </div>
        <p class="dx__vs"><span>Other pawn software</span>Not listed.</p>
      </article>
    </div>

    <p class="dx__note" data-reveal>
      Compared against the public feature pages of other pawn systems, reviewed November 2026. Those
      claims are their own and were not independently verified. Rates shown are illustrative.
    </p>

    <div class="dx__switch" data-reveal>
      <div class="dx__switch-txt">
        <h3>And switching costs you nothing</h3>
        <p>
          Our PawnMate importer brings your customers, loans and inventory across as they are.
          Migration and onboarding are free — you keep your history, not just your data.
        </p>
      </div>
      <a
        class="btn btn--primary dx__switch-cta"
        href="#book-demo"
        data-demo-modal
        data-demo-cta="Differentiators — Book a Free Demo"
      >
        Book a Free Demo<span class="ico"><Icon name="arrow-right" size={18} /></span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Dark indigo band, same treatment as the hero's web + phone showcase, so the
     page has one dark beat in the middle rather than two unrelated ones. */
  .dx {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 55% at 50% 0%, rgb(96 93 236 / .40), rgb(96 93 236 / 0)),
      linear-gradient(180deg, #17153a 0%, #1e1b4b 55%, #262262 100%);
  }

  .dx__head { gap: 16px; margin-bottom: 56px; }
  .dx__head :global(.eyebrow) {
    background: rgb(255 255 255 / .10);
    border-color: rgb(255 255 255 / .22);
    color: #fff;
  }
  .dx__head :global(.eyebrow .dot) { background: #a5b4fc; }
  .dx__head :global(.h-section) { color: #fff; }
  .dx__head :global(.lede) { color: #c9c7e8; }

  /* ---------- Bento grid ---------- */
  .dx__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }

  .dx__tile {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: rgb(255 255 255 / .055);
    border: 1px solid rgb(255 255 255 / .11);
    border-radius: var(--r-20);
    transition: transform .4s var(--ease), background-color .4s var(--ease),
                border-color .4s var(--ease), box-shadow .4s var(--ease);
  }
  .dx__tile:hover {
    transform: translateY(-5px);
    background: rgb(255 255 255 / .085);
    border-color: rgb(165 180 252 / .42);
    box-shadow: 0 24px 46px -24px rgb(0 0 0 / .65);
  }
  .dx__tile--wide { grid-column: span 4; }

  /* Visual sits on top of the copy, as in the mockup sections. */
  .dx__viz {
    display: flex; flex-direction: column; justify-content: center;
    min-height: 136px;
    margin-bottom: 20px;
    padding: 16px;
    background: rgb(12 10 38 / .55);
    border: 1px solid rgb(255 255 255 / .08);
    border-radius: var(--r-14);
  }

  .dx__body { display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .dx__ico {
    display: grid; place-items: center;
    width: 34px; height: 34px;
    border-radius: var(--r-10);
    background: rgb(165 180 252 / .16);
    color: #c7d2fe;
    transition: background-color .35s var(--ease), color .35s var(--ease), transform .35s var(--ease);
  }
  .dx__tile:hover .dx__ico { background: var(--primary); color: #fff; transform: scale(1.06) rotate(-4deg); }
  .dx__body h3 { font-size: 17px; font-weight: 700; line-height: 24px; color: #fff; }
  .dx__body p { font-size: 14.5px; line-height: 23px; color: #b9b6e0; }

  /* The one-line competitor contrast, hung off the bottom rule of each tile. */
  .dx__vs {
    margin-top: 18px; padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / .09);
    font-size: 13px; line-height: 20px; color: #8683b5;
  }
  .dx__vs span {
    display: block;
    margin-bottom: 3px;
    font-size: 10px; font-weight: 700; letter-spacing: .9px; text-transform: uppercase;
    color: #6f6ca0;
  }

  /* ---------- 1. Offline strip ---------- */
  .vo { display: flex; flex-direction: column; gap: 14px; }
  .vo__bar {
    position: relative;
    display: flex; align-items: center; gap: 9px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgb(255 255 255 / .08);
    font-size: 12px; font-weight: 700; letter-spacing: .3px;
  }
  .vo__dot {
    width: 8px; height: 8px; border-radius: 99px; flex: none;
    background: var(--amber);
    box-shadow: 0 0 0 4px rgb(245 158 11 / .18);
    animation: voDot 8s var(--ease) infinite;
  }
  .vo__state { position: absolute; left: 17px; }
  .vo__state--off { color: #fcd34d; animation: voOff 8s var(--ease) infinite; }
  .vo__state--on { color: #6ee7b7; animation: voOn 8s var(--ease) infinite; }

  .vo__lines { display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .vo__lines li {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: #d4d2ee;
  }
  .vo__lines i {
    display: grid; place-items: center; flex: none;
    width: 17px; height: 17px; border-radius: 99px;
    background: var(--primary); color: #fff;
    animation: voTick 8s var(--ease) infinite;
  }
  .vo__lines li:nth-child(2) i { animation-delay: .55s; }
  .vo__lines li:nth-child(3) i { animation-delay: 1.1s; }

  @keyframes voTick {
    0%, 7%    { opacity: 0; transform: scale(.5); }
    14%, 74%  { opacity: 1; transform: scale(1); }
    82%, 100% { opacity: 0; transform: scale(.5); }
  }
  @keyframes voOff { 0%, 56% { opacity: 1; } 62%, 90% { opacity: 0; } 95%, 100% { opacity: 1; } }
  @keyframes voOn  { 0%, 56% { opacity: 0; } 62%, 90% { opacity: 1; } 95%, 100% { opacity: 0; } }
  @keyframes voDot {
    0%, 56%   { background: var(--amber); box-shadow: 0 0 0 4px rgb(245 158 11 / .18); }
    62%, 90%  { background: var(--green); box-shadow: 0 0 0 4px rgb(16 185 129 / .20); }
    95%, 100% { background: var(--amber); box-shadow: 0 0 0 4px rgb(245 158 11 / .18); }
  }

  /* ---------- 2. Two countries ---------- */
  .vf { display: flex; align-items: center; justify-content: center; gap: 12px; }
  .vf__badge {
    display: grid; place-items: center;
    width: 46px; height: 34px;
    border-radius: var(--r-8);
    background: rgb(165 180 252 / .14);
    border: 1px solid rgb(165 180 252 / .34);
    font-size: 14px; font-weight: 800; letter-spacing: .5px; color: #e0e7ff;
  }
  .vf__plus { color: #8683b5; display: grid; place-items: center; }
  .vf__chips {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 6px;
    margin-top: 14px;
  }
  .vf__chips span {
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / .07);
    font-size: 11px; font-weight: 600; color: #c9c7e8;
  }

  /* ---------- 3. Compliance checklist ---------- */
  .vc { display: flex; flex-direction: column; gap: 7px; }
  .vc li { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: #d4d2ee; }
  .vc i {
    display: grid; place-items: center; flex: none;
    width: 16px; height: 16px; border-radius: 99px;
    background: rgb(16 185 129 / .22); color: #6ee7b7;
  }
  .vc__foot {
    margin-top: 12px; padding-top: 10px;
    border-top: 1px solid rgb(255 255 255 / .08);
    font-size: 11px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase;
    color: #6ee7b7;
  }

  /* ---------- 4. Window + phone silhouettes ---------- */
  .vd { display: flex; align-items: flex-end; justify-content: center; gap: 12px; }
  .vd__win, .vd__phone {
    display: flex; flex-direction: column; gap: 6px;
    padding: 9px;
    background: rgb(255 255 255 / .07);
    border: 1px solid rgb(255 255 255 / .14);
  }
  .vd__win { width: 118px; height: 92px; border-radius: var(--r-8); }
  .vd__phone { width: 54px; height: 104px; border-radius: var(--r-10); }
  .vd__chrome { display: flex; gap: 3px; margin-bottom: 2px; }
  .vd__chrome i { width: 4px; height: 4px; border-radius: 99px; background: rgb(255 255 255 / .3); }
  .vd__notch {
    width: 18px; height: 3px; border-radius: 99px; margin: 0 auto 3px;
    background: rgb(255 255 255 / .3);
  }
  .vd__l { height: 5px; border-radius: 99px; background: rgb(165 180 252 / .34); }
  .vd__fig { font-size: 13px; font-weight: 800; color: #c7d2fe; letter-spacing: -.3px; }
  .vd__tag {
    margin-top: auto;
    font-size: 9px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase;
    color: #8683b5;
  }

  /* ---------- 5. Metal rates ---------- */
  .vm { position: relative; display: flex; flex-direction: column; gap: 7px; }
  .vm__live {
    position: absolute; top: -2px; right: 0;
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 9.5px; font-weight: 800; letter-spacing: .8px; text-transform: uppercase;
    color: #6ee7b7;
  }
  .vm__live i {
    width: 6px; height: 6px; border-radius: 99px; background: var(--green);
    animation: vmPulse 2.2s ease-in-out infinite;
  }
  @keyframes vmPulse { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }

  .vm__row { display: flex; align-items: baseline; gap: 8px; }
  .vm__k {
    display: inline-flex; align-items: center; gap: 7px;
    width: 64px; flex: none;
    font-size: 12px; color: #b9b6e0;
  }
  .vm__sw { width: 8px; height: 8px; border-radius: 99px; flex: none; }
  .vm__sw--g { background: #fbbf24; }
  .vm__sw--s { background: #cbd5e1; }
  .vm__row b { font-size: 17px; font-weight: 800; color: #fff; letter-spacing: -.4px; }
  .vm__u { font-size: 11px; color: #8683b5; }
  .vm__spark { width: 100%; height: 34px; margin-top: 4px; }

  /* ---------- Note + switch band ---------- */
  .dx__note {
    margin: 20px auto 0;
    max-width: 780px;
    text-align: center;
    font-size: 12.5px; line-height: 20px; color: #7a77ab;
  }

  .dx__switch {
    display: flex; align-items: center; justify-content: space-between; gap: 40px;
    margin-top: 44px;
    padding: 34px 40px;
    background: rgb(255 255 255 / .07);
    border: 1px solid rgb(165 180 252 / .30);
    border-radius: var(--r-20);
  }
  .dx__switch-txt { display: flex; flex-direction: column; gap: 8px; }
  .dx__switch-txt h3 {
    font-family: var(--serif); font-size: 28px; line-height: 36px; color: #fff;
  }
  .dx__switch-txt p { font-size: 15.5px; line-height: 25px; color: #c9c7e8; max-width: 640px; }
  .dx__switch-cta { flex: none; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1080px) {
    .dx__grid { grid-template-columns: repeat(2, 1fr); }
    .dx__tile { grid-column: span 1; }
    .dx__tile--wide { grid-column: span 2; }
    .dx__switch { padding: 28px 30px; gap: 26px; }
    .dx__switch-txt h3 { font-size: 24px; line-height: 32px; }
  }

  @media (max-width: 720px) {
    .dx__head { margin-bottom: 36px; }
    .dx__grid { grid-template-columns: 1fr; gap: 14px; }
    .dx__tile, .dx__tile--wide { grid-column: span 1; }
    .dx__tile { padding: 20px; }
    .dx__viz { min-height: 0; margin-bottom: 18px; }
    .vo__lines { gap: 8px 16px; }
    .dx__note { text-align: left; margin-top: 18px; }
    .dx__switch {
      flex-direction: column; align-items: flex-start; gap: 20px;
      margin-top: 32px; padding: 24px 20px;
    }
    .dx__switch-txt h3 { font-size: 22px; line-height: 30px; }
    .dx__switch-txt p { font-size: 14.5px; line-height: 24px; }
    .dx__switch-cta { width: 100%; }
  }
</style>
