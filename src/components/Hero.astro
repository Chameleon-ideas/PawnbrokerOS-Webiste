---
import Icon from './Icon.astro';
import PhoneOwner from './mockups/PhoneOwner.astro';
import DemoCard from './DemoCard.astro';
import AppFooter from './mockups/AppFooter.astro';
import Scaler from './mockups/Scaler.astro';
import BrowserBar from './mockups/BrowserBar.astro';
import AppNav from './mockups/AppNav.astro';


const rows = [
  { id: '08104372', name: 'Acevedo, Maria',   phone: '(416) 555-8142', loans: '3', visit: '02/14/24', flag: { t: 'VIP', c: 'amber' } },
  { id: '08104221', name: 'Brennan, Tom',     phone: '(416) 555-8271', loans: '3', visit: '02/14/24', flag: null },
  { id: '08102999', name: 'Caldwell, Jasmine',phone: '(647) 555-3398', loans: '-', visit: '02/14/24', flag: null },
  { id: '08103031', name: 'Daniels, Frank',   phone: '(416) 555-1289', loans: '4', visit: '02/23/24', flag: { t: 'Active', c: 'green' } },
  { id: '08103762', name: 'Esposito, Rosa',   phone: '(416) 555-9965', loans: '-', visit: '02/14/24', flag: null },
  { id: '08102545', name: 'Fairchild, Henry', phone: '(905) 555-8181', loans: '-', visit: '02/14/24', flag: null },
  { id: '08103379', name: 'Hatfield, Beverly',phone: '(416) 555-7962', loans: '-', visit: '12/04/18', flag: { t: 'DO NOT LOAN', c: 'red' } },
];
---

<section class="hero" id="top">
  <div class="hero__top">
  <div class="hero__text" data-reveal-group="90">
    <span class="eyebrow eyebrow--bordered hero__eyebrow" data-reveal>
      ✦ One System. One Counter. Zero Guesswork.
    </span>

    <h1 class="hero__h1 display" data-reveal>
      Every Loan, Every Item, Every Dollar All in One Place.
    </h1>

    <p class="hero__lede" data-reveal>
      PawnbrokerOS replaces the paper tickets, scattered spreadsheets, and generic software that slow
      your counter down. Manage customers, pawn loans, payments, inventory, sales, layaway,
      forfeiture, and your cash till all connected, all in one desktop application.
    </p>

    <div class="hero__actions" data-reveal>
      <a class="btn btn--secondary" href="#hero-preview">See How It Works</a>
    </div>
  </div>

  <div class="hero__book" data-reveal>
    <DemoCard cta="Hero — Book a demo" />
  </div>
  </div>

</section>

<!-- The web + Owner app preview in its own dark band, set apart from the hero (owner, 2026-11-24) -->
<section class="showcase" aria-labelledby="showcase-title">
  <!-- Heading for the web + phone preview (owner, 2026-11-24) -->
  <div class="sec-head hero__prev-head" id="hero-preview-head" data-reveal>
    <span class="eyebrow">At the Counter and On the Go</span>
    <h2 class="h-section" id="showcase-title" style="max-width:760px">Run the Counter in the Shop. Watch the Shop From Anywhere.</h2>
    <p class="lede" style="max-width:620px">
      Staff serve customers, write loans and ring up sales on the PawnbrokerOS web app. Owners
      get the PawnbrokerOS Owner app on their phone: today's cash, loans written, overdue
      pawns, every till and what needs attention, live from the shop wherever they are.
    </p>
  </div>

  <div class="hero__visual" id="hero-preview" data-reveal>
    <Scaler width={1480} class="hero__scaler">
      <div class="hero__stage">
        <!-- ---------------- app window ---------------- -->
        <div class="mock hero__win">
          <BrowserBar url="dashboard.pawnbrokeros.com / customers" padding="12px 16px" dot={11} urlWidth={440} font={12} bg="var(--surface-3)" />

          <AppNav active="Customer" height={64} padding="0 20px" markSize={26} wordSize={15} tabSize={12} />

          <div class="hc">
            <!-- Header card, as in the dashboard: action on top, figures below with dividers -->
            <div class="kc">
              <div class="kc__bar">
                <button type="button" class="kc__btn"><Icon name="scan" size={13} />Scan ID</button>
                <button type="button" class="kc__btn kc__btn--solid"><Icon name="plus" size={13} />Add new customer</button>
              </div>
              <div class="kc__figs">
                <div><span>Customers</span><b data-count="4288">4,288</b></div>
                <div><span>With an active pawn</span><b data-count="938">938</b></div>
                <div><span>Flagged</span><b data-count="77">77</b></div>
              </div>
            </div>

            <div class="lc">
            <div class="tb">
              <div class="seg">
                <button type="button" class="seg__t is-on" data-seg="all">All <i>4,288</i></button>
                <button type="button" class="seg__t" data-seg="active">Active <i>938</i></button>
                <button type="button" class="seg__t" data-seg="inactive">Inactive <i>3,350</i></button>
              </div>
              <span class="tb__sp"></span>
              <span class="tb__sel">All flags<Icon name="chevron-down" size={13} /></span>
              <span class="tb__search"><Icon name="search" size={14} />Name, phone, email, last 4 SIN</span>
            </div>
            <div class="hc__table">
              <table class="tbl">
                <thead>
                  <tr>
                    <th style="width:44px"><span class="cbx" data-cbx-all></span></th>
                    <th style="width:120px">CUSTOMER #</th>
                    <th>NAME</th>
                    <th style="width:160px">PHONE</th>
                    <th style="width:120px" class="num">ACTIVE LOANS</th>
                    <th style="width:110px">LAST VISIT</th>
                    <th style="width:160px">FLAGS</th>
                    <th style="width:90px" class="num">ACTION</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr data-active={r.loans !== '-' ? '1' : '0'}>
                      <td><span class="cbx" data-cbx></span></td>
                      <td class="dim">{r.id}</td>
                      <td class="name">{r.name}</td>
                      <td>{r.phone}</td>
                      <td class="num"><b>{r.loans}</b></td>
                      <td>{r.visit}</td>
                      <td>{r.flag ? <span class={`chip chip--${r.flag.c}`}>{r.flag.t}</span> : <span class="dim">-</span>}</td>
                      <td class="num"><span class="open">Open<Icon name="chevron-right" size={11} /></span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <div class="pager">
                <span data-showing>Showing 7 of 4,288 records</span>
                <span>Page 1 of 12</span>
                <span class="pager__btns"><span>Prev</span><span>Next</span></span>
              </div>
            </div>
            </div>
          </div>
          <AppFooter font={12} height={40} />
        </div>

        <!-- owner's mobile app, overlapping the web preview (2026-11-24) -->
        <div class="hero__phone" data-float="0.05"><PhoneOwner /></div>
      </div>
    </Scaler>
  </div>
</section>

<script>
  // Light interaction on the hero preview: the All / Active / Inactive tabs filter the sample
  // rows, and the row checkboxes tick. Nothing else changes screens.
  const win = document.querySelector('.hero__win');
  if (win) {
    // Keep the window the same height when a tab shows fewer rows, so the page never jumps.
    const tableWrap = win.querySelector<HTMLElement>('.hc__table');
    if (tableWrap) {
      tableWrap.style.minHeight = `${tableWrap.offsetHeight}px`;
      tableWrap.style.display = 'flex';
      tableWrap.style.flexDirection = 'column';
      const pager = tableWrap.querySelector<HTMLElement>('.pager');
      if (pager) pager.style.marginTop = 'auto';
    }
    const rows = Array.from(win.querySelectorAll<HTMLTableRowElement>('tbody tr'));
    const showing = win.querySelector('[data-showing]');
    const totals: Record<string, string> = { all: '4,288', active: '938', inactive: '3,350' };
    win.querySelectorAll<HTMLButtonElement>('[data-seg]').forEach((b) =>
      b.addEventListener('click', () => {
        win.querySelectorAll('[data-seg]').forEach((x) => x.classList.toggle('is-on', x === b));
        const v = b.dataset.seg!;
        let n = 0;
        rows.forEach((r) => {
          const show = v === 'all' || (v === 'active') === (r.dataset.active === '1');
          r.hidden = !show;
          if (show) n++;
        });
        if (showing) showing.textContent = `Showing ${n} of ${totals[v]} records`;
      }),
    );
    rows.forEach((r) =>
      r.addEventListener('click', () => {
        r.classList.toggle('is-sel');
        r.querySelector('[data-cbx]')?.classList.toggle('is-on', r.classList.contains('is-sel'));
      }),
    );
    win.querySelector('[data-cbx-all]')?.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      const on = !el.classList.contains('is-on');
      el.classList.toggle('is-on', on);
      rows.filter((r) => !r.hidden).forEach((r) => {
        r.classList.toggle('is-sel', on);
        r.querySelector('[data-cbx]')?.classList.toggle('is-on', on);
      });
    });
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    padding: 170px var(--gutter) 120px;
    background: linear-gradient(160deg, #f5f3ff 0%, #ede9fe 45%, #f8f7ff 100%);
  }

  /* Copy on the left, the booking card on the right (owner, 2026-11-24). */
  .hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    align-items: center;
    gap: 64px;
    width: 100%;
    max-width: var(--content);
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    text-align: left;
  }
  .hero__eyebrow { color: var(--primary-700); letter-spacing: 1.2px; }

  .hero__h1 {
    font-size: 68px;
    line-height: 72px;
    letter-spacing: -1.6px;
  }

  .hero__lede { font-size: 18px; line-height: 30px; color: var(--muted); }

  .hero__actions { display: flex; gap: 14px; }

  /* --- visual --- */
  /* "See How It Works" lands here; with the global scroll-padding (84px) this clears the navbar. */
  /* Sized from the viewport height so the whole preview fits on screen (owner, 2026-11-24).
     The stage is 1280×720, so width = 1.78 × height. */
  @media (max-width: 760px) { .showcase { padding: 72px var(--gutter) 80px; } }
  .showcase {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    padding: 110px var(--gutter) 120px;
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 50% 100%, rgb(96 93 236 / .45), rgb(96 93 236 / 0)),
      linear-gradient(180deg, #17153a 0%, #1e1b4b 55%, #262262 100%);
  }
  .hero__prev-head :global(.eyebrow) { background: rgb(255 255 255 / .1); color: #c7c4ff; }
  .hero__prev-head :global(.h-section) { color: #fff; }
  .hero__prev-head :global(.lede) { color: #c9c7e8; }
  /* the hero no longer holds the preview, so it needs less bottom space */
  .hero { padding-bottom: 110px; }
  .hero__visual {
    width: 100%;
    max-width: min(1480px, calc((100vh - 150px) * 2.05));
    scroll-margin-top: 36px;
  }
  /* Web window at 75% on the left, phone beside it on the right, just touching the
     window's edge so nothing in either is hidden, both flat, with a soft glow behind tying them together. */
  .hero__stage { position: relative; width: 1480px; height: 700px; }
  .hero__stage::before {
    content: '';
    position: absolute;
    inset: 40px 60px 0 120px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(96 93 236 / .22), rgb(96 93 236 / 0));
    filter: blur(30px);
    pointer-events: none;
  }
  .hero__win {
    position: absolute;
    left: 0;
    top: 34px;
    width: 1280px;
    transform: scale(.8);
    transform-origin: top left;
  }
  .hero__win { border-color: #e2dcf7; }

  /* page header */

  /* content */
  .hc { display: flex; flex-direction: column; gap: 22px; padding: 22px; background: #fff; border-top: 1px solid var(--border); }
  .hc__table { overflow: hidden; }

  /* header card: action bar on top, figures with dividers below */
  .kc { border: 1px solid var(--border); border-radius: 14px; background: #fff; box-shadow: var(--sh-sm); overflow: hidden; }
  .kc__bar { display: flex; justify-content: flex-end; gap: 8px; padding: 12px 18px; background: var(--surface); border-bottom: 1px solid var(--border); }
  .kc__btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border: 1px solid var(--border-violet); border-radius: 99px; background: #fff; font-size: 12px; font-weight: 600; color: var(--ink-700); }
  .kc__btn { font-family: inherit; cursor: pointer; transition: border-color .15s, background-color .15s, transform .1s; }
  .kc__btn:hover { border-color: var(--primary); }
  .kc__btn:active { transform: translateY(1px); }
  .kc__btn--solid { background: var(--primary); border-color: var(--primary); color: #fff; }
  .kc__btn--solid:hover { background: var(--primary-deep); }
  .hc__table tbody tr { cursor: pointer; }
  .hc__table tbody tr.is-sel { background: var(--lilac-100, #ede9fe); }
  .hc__table tbody tr[hidden] { display: none; }
  .cbx { cursor: pointer; }
  .cbx.is-on { background: var(--primary); border-color: var(--primary); box-shadow: inset 0 0 0 2px #fff; }
  .kc__figs { display: grid; grid-template-columns: repeat(3, 1fr); padding: 16px 0; }
  .kc__figs div { display: flex; flex-direction: column; gap: 6px; padding: 0 22px; }
  .kc__figs div + div { border-left: 1px solid var(--border); }
  .kc__figs span { font-size: 12px; color: var(--muted); }
  .kc__figs b { font-size: 22px; font-weight: 800; color: var(--ink-800); }

  /* list card: segmented tabs, filter and search on top of the table */
  .lc { border: 1px solid var(--border); border-radius: 14px; background: #fff; box-shadow: var(--sh-sm); overflow: hidden; }
  .tb { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--surface); border-bottom: 1px solid var(--border); }
  .tb__sp { flex: 1; }
  .seg { display: flex; gap: 4px; padding: 4px; border: 1px solid var(--border-violet); border-radius: 99px; background: #fff; }
  .seg__t { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 99px; font-size: 12px; font-weight: 600; color: var(--muted); }
  .seg__t i { font-style: normal; font-size: 10px; padding: 1px 7px; border-radius: 99px; background: var(--surface-3); color: var(--muted); }
  .seg__t { border: 0; background: none; font-family: inherit; cursor: pointer; transition: background-color .15s, color .15s; }
  .seg__t:hover:not(.is-on) { background: var(--surface); color: var(--ink-800); }
  .seg__t.is-on { background: var(--primary); color: #fff; }
  .seg__t.is-on i { background: rgb(255 255 255 / .22); color: #fff; }
  .tb__sel { display: inline-flex; align-items: center; justify-content: space-between; gap: 30px; width: 150px; padding: 7px 12px; border: 1px solid var(--border-violet); border-radius: 99px; background: #fff; font-size: 12px; color: var(--ink-700); }
  .tb__search { display: inline-flex; align-items: center; gap: 8px; width: 270px; padding: 7px 12px; border: 1px solid var(--border-violet); border-radius: 99px; background: #fff; font-size: 12px; color: var(--muted-3); }
  .hc__table :global(.tbl th) { padding: 10px 14px; }
  .hc__table :global(.tbl td) { padding: 11px 14px; font-size: 12px; }
  .hc__table :global(.tbl thead th:first-child) { padding: 10px; }
  .hc__table :global(.tbl tbody td:first-child) { padding: 11px 10px; }

  .cbx {
    display: inline-block;
    width: 14px; height: 14px;
    background: #fff;
    border: 1px solid var(--border-violet);
    border-radius: 3px;
  }
  .open {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 12px; font-weight: 700; color: var(--grey-700);
    transition: color .2s var(--ease), gap .2s var(--ease);
  }
  tr:hover .open { color: var(--primary); gap: 7px; }

  /* floaters */
  .flt {
    position: absolute;
    width: 196px;
    display: flex; flex-direction: column; gap: 2px;
    padding: 16px;
    background: #fff;
    border: 1px solid var(--lilac-50);
    border-radius: var(--r-12);
    box-shadow: var(--sh-lg);
    transform: translateY(var(--py, 0));
    transition: box-shadow .35s var(--ease);
  }
  .flt:hover { box-shadow: 0 22px 40px -18px rgb(76 29 149 / .45); }
  .flt { pointer-events: none; } /* decorative; never block clicks on the preview */
  .hero__phone { position: absolute; left: 1150px; top: 20px; z-index: 3; }
  .flt--a { left: -40px; top: 220px; animation: bob 7s ease-in-out infinite; }

  .flt__k {
    display: flex; align-items: center; gap: 6px;
    margin-bottom: 8px;
    font-size: 10px; font-weight: 600; letter-spacing: .5px;
    text-transform: uppercase; color: var(--muted-2);
  }
  .flt__k i { width: 7px; height: 7px; border-radius: 99px; flex: none; }
  .flt__v { font-size: 28px; line-height: 32px; font-weight: 700; }
  .flt__u { font-size: 12px; color: var(--muted-3); }

  @keyframes bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -10px; }
  }
  @media (prefers-reduced-motion: reduce) { .flt { animation: none; } }

  /* --- responsive --- */
  @media (max-width: 1100px) {
    .hero { gap: 56px; padding: 96px var(--gutter); }
    .hero__top { grid-template-columns: minmax(0, 1fr) 380px; gap: 40px; }
    .hero__h1 { font-size: 52px; line-height: 56px; }
  }
  @media (max-width: 980px) {
    .hero__top { grid-template-columns: 1fr; gap: 48px; }
    .hero__book { width: 100%; max-width: 520px; }
  }
  @media (max-width: 760px) {
    .hero { gap: 40px; padding: 96px var(--gutter) 60px; }
    .hero__text { gap: 24px; }
    .hero__h1 { font-size: 38px; line-height: 42px; letter-spacing: -1px; }
    .hero__lede { font-size: 15px; line-height: 24px; }
    .hero__actions { flex-direction: column; width: 100%; gap: 12px; }
  }
</style>
