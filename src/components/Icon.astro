const d = P[name] ?? '';
const px = typeof size === 'number' ? `${size}px` : size;
---

<svg
  class={`ico ${cls}`}
  width={px}
  height={px}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={d}
/>

<style>
  .ico { flex: none; }
</style>
