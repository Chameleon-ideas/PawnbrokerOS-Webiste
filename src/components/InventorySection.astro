---
import Icon from './Icon.astro';
import Scaler from './mockups/Scaler.astro';
import BrowserBar from './mockups/BrowserBar.astro';
import AppNav from './mockups/AppNav.astro';

const stats = [
  { k: 'TOTAL ITEMS',     v: '1,842', u: 'in stock' },
  { k: 'FORFEITED PAWNS', v: '623',   u: 'items' },
  { k: 'PURCHASED',       v: '891',   u: 'outright buys' },
  { k: 'DIRECT STOCK',    v: '328',   u: 'added manually' },
];

const rows = [
  { sku: '#PD-9481-A', d: '14K Gold Diamond Band, 0.5ct',   cat: 'Jewelry',     bin: 'Vault - Section B', cond: { t: 'Excellent', c: 'green' }, p: '$799.00',   o: 'Forfeit' },
  { sku: '#PD-4821-B', d: 'Sony PlayStation 5 Console',     cat: 'Electronics', bin: 'Shelf - Row 4',     cond: { t: 'Good', c: 'green' },      p: '$349.00',   o: 'Purchase' },
  { sku: '#PD-1029-C', d: 'Taylor GS Mini Acoustic Guitar', cat: 'Instruments', bin: 'Wall Mount 12',     cond: { t: 'Fair', c: 'amber' },      p: '$450.00',   o: 'Forfeit' },
  { sku: '#PD-3344-D', d: 'Vintage Rolex Oyster Perpetual', cat: 'Watches',     bin: 'Vault - Section A', cond: { t: 'Excellent', c: 'green' }, p: '$3,200.00', o: 'Purchase' },
  { sku: '#PD-7762-E', d: 'Milwaukee M18 Power Tool Set',   cat: 'Tools',       bin: 'Shelf - Row 9',     cond: { t: 'Good', c: 'green' },      p: '$285.00',   o: 'Direct' },
];

const bullets = [
  'Search inventory', 'Track bin location', 'Edit item details', 'Bulk edit items',
  'Manage categories', 'Print barcode labels', 'Track item condition', 'Track item origin',
];

const details = [
  { t: 'Item Details & Identification', d: "Description, barcode, category, subcategory, and condition captured when the item enters inventory so staff never have to guess what they're looking at." },
  { t: 'Bin & Location Tracking',       d: 'Assign items to specific shelf rows, vault sections, or display areas. When a customer asks about something, staff know exactly where to walk.' },
  { t: 'Origin & Source Audit',         d: 'See whether each item came from a forfeited pawn, an outright purchase, or a direct stock entry, a clear trail for every piece of inventory.' },
  { t: 'Barcode Labels & Pricing',      d: 'Print custom barcode price labels in seconds from any inventory record. Price it, label it, and get it on the shelf without a separate system.' },
];
---

<section class="section inv">
  <div class="container">
    <div class="sec-head" data-reveal>
      <span class="eyebrow eyebrow--bordered" style="letter-spacing:1.5px">Every Item Accounted For</span>
      <h2 class="h-section">Track What's on the Shelf, What's in the Back, and How It Got There.</h2>
      <p class="lede" style="max-width:600px">
        Forfeited pawns, outright purchases, and manually added stock every item in your shop has an
        origin, a location, and a price. PawnDesk keeps them organized so staff can find anything in
        seconds and nothing sits forgotten.
      </p>
    </div>

    <div class="inv__visual" data-reveal>
      <Scaler width={1280}>
        <div class="mock inv__win" style="width:1280px">
          <BrowserBar url="pawndesk.app / inventory" padding="12px 16px" dot={11} urlWidth={380} font={11} />
          <AppNav
            tabs={['Customer', 'Pawn/Loan', 'Inventory', 'Sale', 'Transactions', 'Reports']}
            active="Inventory" height={52} padding="0 24px" gap={28} markSize={26} wordSize={13} tabSize={12} userName
          />

          <div class="inv__ph">
            <div>
              <h3>Inventory</h3>
              <p>All items · 1,842 records</p>
            </div>
            <div class="inv__pha">
              <span class="pill-btn">Export</span>
              <span class="pill-btn">Bulk Edit</span>
              <span class="pill-btn pill-btn--solid"><Icon name="plus" size={13} />Add Item</span>
            </div>
          </div>

          <div class="inv__body">
            <div class="inv__stats">
              {stats.map((s) => (
                <div class="stat" style="padding:14px;gap:6px">
                  <span class="stat__k">{s.k}</span>
                  <b class="stat__v" style="font-size:24px">{s.v}</b>
                  <span class="stat__u" style="font-size:11px">{s.u}</span>
                </div>
              ))}
            </div>

            <div class="inv__filters">
              <div class="fld" style="flex:1">
                <span class="fld__l">Search Inventory</span>
                <span class="fld__c"><Icon name="search" size={14} /><span class="ph">SKU, barcode, description...</span></span>
              </div>
              <div class="fld" style="width:150px">
                <span class="fld__l">Origin</span>
                <span class="fld__c">All Sources<Icon name="chevron-down" size={13} class="sp" /></span>
              </div>
              <div class="fld" style="width:150px">
                <span class="fld__l">Category</span>
                <span class="fld__c">All Categories<Icon name="chevron-down" size={13} class="sp" /></span>
              </div>
              <div class="fld" style="width:130px">
                <span class="fld__l">Status</span>
                <span class="fld__c">Available<Icon name="chevron-down" size={13} class="sp" /></span>
              </div>
            </div>

            <div class="inv__table">
              <table class="tbl">
                <thead>
                  <tr>
                    <th style="width:44px"><span class="cbx"></span></th>
                    <th style="width:100px">BARCODE / SKU</th>
                    <th>ITEM DESCRIPTION</th>
                    <th style="width:120px">CATEGORY</th>
                    <th style="width:130px">BIN LOCATION</th>
                    <th style="width:80px">CONDITION</th>
                    <th style="width:100px" class="num">PRICE</th>
                    <th style="width:100px">ORIGIN</th>
                    <th style="width:80px" class="num">ACTION</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr>
                      <td><span class="cbx"></span></td>
                      <td class="dim">{r.sku}</td>
                      <td class="name">{r.d}</td>
                      <td>{r.cat}</td>
                      <td>{r.bin}</td>
                      <td><span class={`chip chip--${r.cond.c}`}>{r.cond.t}</span></td>
                      <td class="num" style="color:var(--ink-700);font-weight:700">{r.p}</td>
                      <td><span class="badge-sec">{r.o}</span></td>
                      <td class="num"><span class="open">Open<Icon name="chevron-right" size={11} /></span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <div class="pager">
                <span>Showing 5 of 1,842 records</span>
                <span>Page 1 of 369</span>
                <span class="pager__btns"><span>Prev</span><span style="opacity:1">Next</span></span>
              </div>
            </div>
          </div>
        </div>
      </Scaler>
    </div>

    <div class="inv__bottom">
      <div class="inv__col" data-reveal>
        <h3 class="h-step" style="line-height:52px">Inventory That Understands a Pawn Shop</h3>
        <p class="inv__p">
          Generic retail software treats every item the same. In a pawn shop, an item might arrive as
          a forfeited loan, an outright buy, or a direct addition and staff need to know which.
          PawnDesk tracks the full picture so every item has a story, a shelf location, and a price.
        </p>
        <div class="inv__grid">
          {bullets.map((b) => (
            <span class="inv__bul"><i><Icon name="check" size={12} /></i>{b}</span>
          ))}
        </div>
      </div>

      <div class="inv__col inv__col--wide" data-reveal>
        <h3 class="h-step">Complete Item Records</h3>
        <p class="inv__p" style="font-size:14px;line-height:22px">
          Every item gets a detailed record from description and condition to where it sits in the
          shop and where it came from. Nothing gets lost between intake and the shelf.
        </p>
        <div class="linklist">
          {details.map((d) => (
            <a class="linklist__item" href="#">
              <span><b>{d.t}</b><em>{d.d}</em></span>
              <Icon name="chevron-right" size={16} />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .inv {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .inv .sec-head { margin-bottom: 64px; }
  .inv__visual { margin-bottom: 48px; }
  .inv__win { border-color: var(--border-violet); box-shadow: var(--sh-violet); }

  .inv__ph {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 24px; background: #fff; border-bottom: 1px solid var(--border);
  }
  .inv__ph h3 { font-size: 22px; font-weight: 700; color: var(--ink-700); }
  .inv__ph p { font-size: 13px; color: var(--muted-2); margin-top: 3px; }
  .inv__pha { display: flex; align-items: center; gap: 8px; }

  .inv__body { display: flex; flex-direction: column; gap: 16px; padding: 22px; background: #fff; }
  .inv__stats { display: flex; gap: 14px; }
  .inv__filters {
    display: flex; align-items: flex-end; gap: 10px;
    padding: 14px 20px;
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    border-radius: var(--r-8);
  }
  .inv__table {
    border: 1px solid var(--border); border-radius: var(--r-10);
    box-shadow: var(--sh-sm); overflow: hidden;
  }
  .inv__table :global(.tbl th) { padding: 10px 14px; }
  .inv__table :global(.tbl td) { padding: 11px 14px; }
  .inv__table :global(.tbl thead th:first-child) { padding: 10px; }
  .inv__table :global(.tbl tbody td:first-child) { padding: 11px 10px; }

  .cbx { display: inline-block; width: 14px; height: 14px; background: #fff; border: 1px solid var(--border-violet); border-radius: 3px; }
  .open {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11px; font-weight: 700; color: var(--grey-700);
    transition: color .2s var(--ease), gap .2s var(--ease);
  }
  tr:hover .open { color: var(--primary); gap: 7px; }

  /* bottom */
  .inv__bottom { display: flex; gap: 64px; }
  .inv__col { display: flex; flex-direction: column; gap: 24px; width: 440px; flex: none; }
  .inv__col--wide { flex: 1; width: auto; gap: 20px; min-width: 0; }
  .inv__p { font-size: 15px; line-height: 26px; color: var(--muted); }

  .inv__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 16px; }
  .inv__bul {
    display: flex; align-items: center; gap: 10px;
    font-size: 14px; font-weight: 600; color: var(--ink-700);
  }
  .inv__bul i {
    display: grid; place-items: center; flex: none;
    width: 24px; height: 24px; border-radius: var(--r-pill);
    background: var(--lilac-50); color: var(--primary);
    transition: background-color .25s var(--ease), color .25s var(--ease), transform .25s var(--ease);
  }
  .inv__bul:hover i { background: var(--primary); color: #fff; transform: scale(1.1); }

  .linklist {
    background: #fff; border: 1px solid var(--border-violet);
    border-radius: var(--r-12); box-shadow: var(--sh-sm); overflow: hidden;
  }
  .linklist__item {
    display: flex; align-items: center; gap: 16px;
    padding: 16px; border-bottom: 1px solid var(--lilac-50);
    transition: background-color .25s var(--ease);
  }
  .linklist__item:last-child { border-bottom: 0; }
  .linklist__item:hover { background: var(--surface); }
  .linklist__item > span { flex: 1; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .linklist__item b { font-size: 14px; font-weight: 500; color: #0a0a0a; }
  .linklist__item em { font-size: 14px; font-style: normal; color: #737373; }
  .linklist__item :global(.ico) { color: #0a0a0a; transition: transform .25s var(--ease); }
  .linklist__item:hover :global(.ico) { transform: translateX(4px); color: var(--primary); }

  @media (max-width: 1100px) {
    .inv__bottom { flex-direction: column; gap: 40px; }
    .inv__col { width: 100%; }
  }
  @media (max-width: 760px) {
    .inv .sec-head { margin-bottom: 40px; }
    .inv__visual { margin-bottom: 32px; }
    .inv__grid { grid-template-columns: 1fr; gap: 14px; }
    .inv__p { font-size: 14px; line-height: 24px; }
  }
</style>
