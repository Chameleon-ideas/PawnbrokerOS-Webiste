        ${/do not/i.test(c.flag) ? '<p class="ld-dr__warn">This customer is flagged “Do not loan”. New pawns are blocked.</p>' : ''}`;
      d.hidden = false;
      $('[data-drclose]', d).addEventListener('click', closeDrawer);
      $('[data-drpawn]', d)?.addEventListener('click', () => {
        go('Pawn');
        toast(`Starting a new pawn for <b>${esc(c.first)} ${esc(c.last)}</b>. In the app this opens the pawn ticket.`);
