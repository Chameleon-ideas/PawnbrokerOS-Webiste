    // ---------------------------------------------------------------- Add-customer wizard
    const wiz = $('[data-wiz]');
    const veil = $('[data-veil]');
    let form: Record<string, string> = {};
    let step = 0;
    const STEPS = ['Scan ID', 'Name & ID', 'Contact', 'Review'];
    const field = (k: string, label: string, ph = '') =>
      `<label class="ld-f"><span>${label}</span><input data-f="${k}" value="${esc(form[k] || '')}" placeholder="${ph}" /></label>`;
    const closeWiz = () => {
      wiz.hidden = true;
      veil.hidden = true;
    };
    const drawWiz = () => {
      const body =
        step === 0
          ? `<div class="ld-w__scan"><span class="ld-w__ico">${ico.scan}</span><div><b>Scan the customer's ID</b><em>Scan the large barcode on the back of the licence. The details fill in on their own.</em></div></div>
             <div class="ld-w__input" data-scanbox>Waiting for scan… (or paste barcode data)</div>
             <button class="ld-btn ld-btn--ghost" data-simscan>${ico.scan}Simulate a licence scan</button>`
          : step === 1
            ? `<div class="ld-w__grid">${field('first', 'First name')}${field('middle', 'Middle')}${field('last', 'Last name')}${field('dob', 'Date of birth', 'yyyy-mm-dd')}${field('idno', 'Licence #')}${field('exp', 'ID expires', 'yyyy-mm-dd')}</div>`
            : step === 2
              ? `<div class="ld-w__grid">${field('phone', 'Phone', '(___) ___-____')}${field('email', 'Email (optional)', 'name@example.com')}${field('street', 'Street')}${field('city', 'City')}${field('prov', 'Province')}${field('postal', 'Postal code', 'A1A 1A1')}</div>`
              : `<dl class="ld-w__sum">${[
                  ['Name', `${form.first || ''} ${form.middle || ''} ${form.last || ''}`],
                  ['Date of birth', form.dob],
                  ['Licence', `${form.idno || '—'} · expires ${form.exp || '—'}`],
                  ['Phone', form.phone || '—'],
                  ['Address', [form.street, form.city, form.prov, form.postal].filter(Boolean).join(', ') || '—'],
                ]
                  .map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(v || '—')}</dd></div>`)
                  .join('')}</dl>`;
      wiz.innerHTML = `
        <div class="ld-w__hd"><b>Add new customer</b><button data-wclose aria-label="Close">×</button></div>
        <div class="ld-w__steps">${STEPS.map((s, i) => `<span class="${i === step ? 'is-on' : i < step ? 'is-done' : ''}"><i>${i < step ? '✓' : i + 1}</i>${s}</span>`).join('')}</div>
        <div class="ld-w__body">${body}</div>
        <p class="ld-w__err" data-werr hidden></p>
        <div class="ld-w__ft">
          ${step === 0 ? '<button class="ld-btn" data-wcancel>Cancel</button><button class="ld-btn ld-btn--solid" data-wnext>Enter manually instead</button>' : `<button class="ld-btn" data-wback>Back</button><button class="ld-btn ld-btn--solid" data-wnext>${step === 3 ? 'Save customer' : 'Next'}</button>`}
        </div>`;
      $('[data-wclose]', wiz).addEventListener('click', closeWiz);
      $('[data-wcancel]', wiz)?.addEventListener('click', closeWiz);
      $('[data-wback]', wiz)?.addEventListener('click', () => (step--, drawWiz()));
      $$<HTMLInputElement>('[data-f]', wiz).forEach((i) => i.addEventListener('input', () => (form[i.dataset.f!] = i.value)));
      $('[data-wnext]', wiz).addEventListener('click', () => {
        const err = $('[data-werr]', wiz);
        if (step === 1 && (!form.first?.trim() || !form.last?.trim())) {
          err.textContent = 'First and last name are required.';
          err.hidden = false;
          return;
        }
        if (step === 3) return saveCustomer();
        step++;
        drawWiz();
      });
      $('[data-simscan]', wiz)?.addEventListener('click', simulateScan);
      $<HTMLInputElement>('[data-f]', wiz)?.focus();
    };
    const openWiz = (scan: boolean) => {
      form = {};
      step = 0;
      closeDrawer();
      veil.hidden = false;
      wiz.hidden = false;
      drawWiz();
      if (scan) setTimeout(simulateScan, 350);
    };
    function simulateScan() {
      const box = $('[data-scanbox]', wiz);
      const btn = $<HTMLButtonElement>('[data-simscan]', wiz);
      if (!box || btn?.disabled) return;
      if (btn) btn.disabled = true;
      const line = '@ ANSI 636012090002DL DCSOKAFOR DACAMARA DADNGOZI DBB19890314 DAQO4471-38290-90314 DBA20310314 DAG41 KING ST W DAIOTTAWA DAJON DAKK1P 1A4';
      box.classList.add('is-reading');
      let i = 0;
      const t = setInterval(() => {
        i += 6;
        box.textContent = line.slice(0, i);
        if (i >= line.length) {
          clearInterval(t);
          box.innerHTML = '<b class="ld-ok">✓ Licence read</b> — details filled in';
          form = { first: 'Amara', middle: 'Ngozi', last: 'Okafor', dob: '1989-03-14', idno: 'O4471-38290-90314', exp: '2031-03-14', street: '41 King St W', city: 'Ottawa', prov: 'ON', postal: 'K1P 1A4' };
          setTimeout(() => {
            step = 1;
            drawWiz();
          }, 650);
        }
      }, 30);
    }
    function saveCustomer() {
      const c: Cust = {
        id: 'NEW' + String(4600 + custs.length),
        first: form.first.trim(),
        last: form.last.trim(),
        phone: form.phone || '(613) 555-0142',
        loans: 0,
        visit: new Date().toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: '2-digit' }),
        flag: '',
        email: form.email || '—',
        city: [form.city, form.prov].filter(Boolean).join(', ') || '—',
      };
      custs.unshift(c);
      closeWiz();
      cs.seg = 'All';
      cs.q = '';
      cs.flag = 'all';
      cs.page = 0;
      $<HTMLInputElement>('[data-cq]', sc).value = '';
      $<HTMLSelectElement>('[data-cflag]', sc).value = 'all';
      $$('[data-seg="cust"] button', sc).forEach((b) => b.classList.toggle('is-on', b.dataset.v === 'All'));
      $('[data-cc-total]', sc).textContent = '4,289';
      go('Customer');
      drawCusts();
      toast(`<b>${esc(c.first)} ${esc(c.last)}</b> saved. Next stop in the app: a pawn, buy or sale.`);
    }
    sc.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
      if (a) openWiz(a.dataset.act === 'scan');
