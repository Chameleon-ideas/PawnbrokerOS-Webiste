    veil.addEventListener('click', closeWiz);

    // ---------------------------------------------------------------- Home
    const svg = (d: string) => `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
    const tileIco: Record<string, string> = {
      indigo: svg('<path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z"/><circle cx="7.5" cy="7.5" r="1.2"/>'),
      green: svg('<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>'),
      amber: svg('<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/>'),
      blue: svg('<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2 2h3l2.7 12.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/>'),
      plum: svg('<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2Z"/>'),
    };
    const sh = $('[data-screen="Home"]');
    sh.innerHTML = `
      <div class="ld-home">
        <div class="ld-card">
          <div class="ld-card__hd"><i>1</i><div><b>Find your customer</b><span>Type any part of a name or phone number.</span></div><button class="ld-btn ld-btn--solid" data-hadd>Add new customer</button></div>
          <label class="ld-search ld-search--wide">${ico.search}<input data-hq placeholder="Try “Maria” or “416”" aria-label="Find a customer" /></label>
          <div class="ld-home__res" data-hres><p class="ld-empty">Matching customers and their details appear here.</p></div>
        </div>
        <div class="ld-card">
          <div class="ld-card__hd"><i>2</i><div><b>Choose a transaction</b><span data-hsub>Loan, buy and layaway need a customer. Sales can be walk-in.</span></div></div>
          <div class="ld-tiles">
            ${[
              ['Pawn', 'New loan', 'indigo', true],
              ['Purchases', 'Buy', 'green', true],
              ['Pawn', 'Reload / Redeem / Renew', 'amber', true],
              ['POS', 'Sale / POS', 'blue', false],
              ['Layaways', 'Layaway', 'plum', true],
            ]
              .map(([to, label, tone, need]) => `<button class="ld-tile ld-tile--${tone}" data-to="${to}" data-need="${need ? 1 : 0}" ${need ? 'disabled' : ''}><i>${tileIco[String(tone)]}</i><span><b>${label}</b><em>${need ? 'Select a customer first' : 'Walk-in — no customer needed'}</em></span></button>`)
              .join('')}
          </div>
        </div>
      </div>`;
    let homeCust: Cust | null = null;
    const drawHome = (q: string) => {
      const res = $('[data-hres]', sh);
      if (!q.trim()) {
        res.innerHTML = '<p class="ld-empty">Matching customers and their details appear here.</p>';
        return;
      }
      const m = custs.filter((c) => `${c.first} ${c.last} ${c.phone}`.toLowerCase().includes(q.toLowerCase())).slice(0, 4);
      res.innerHTML = m.length
        ? m.map((c) => `<button class="ld-hit ${homeCust?.id === c.id ? 'is-on' : ''}" data-hid="${c.id}"><b>${esc(c.last)}, ${esc(c.first)}</b><span>${c.phone} · ${c.loans ? c.loans + ' active loan' + (c.loans > 1 ? 's' : '') : 'no active loans'}</span>${c.flag ? chip(c.flag) : ''}</button>`).join('')
        : '<p class="ld-empty">No match. Add them as a new customer.</p>';
    };
    $('[data-hq]', sh).addEventListener('input', (e) => drawHome((e.target as HTMLInputElement).value));
    $('[data-hadd]', sh).addEventListener('click', () => openWiz(false));
    sh.addEventListener('click', (e) => {
      const hit = (e.target as HTMLElement).closest<HTMLElement>('[data-hid]');
      if (hit) {
        homeCust = custs.find((c) => c.id === hit.dataset.hid) || null;
        drawHome($<HTMLInputElement>('[data-hq]', sh).value);
        $$<HTMLButtonElement>('[data-need="1"]', sh).forEach((b) => {
          b.disabled = !homeCust || /do not/i.test(homeCust.flag);
          $('em', b).textContent = homeCust ? (/do not/i.test(homeCust.flag) ? 'Blocked: do-not-loan flag' : `For ${homeCust.first} ${homeCust.last}`) : 'Select a customer first';
        });
        return;
      }
      const tile = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-to]');
      if (tile && !tile.disabled) {
        go(tile.dataset.to!);
        if (homeCust && tile.dataset.need === '1') toast(`Started for <b>${esc(homeCust.first)} ${esc(homeCust.last)}</b>.`);
      }
    });

    // ---------------------------------------------------------------- Pawn
    const sp = $('[data-screen="Pawn"]');
    sp.innerHTML = `
      <div data-pfigs></div>
      <div class="ld-l">
        <div class="ld-l__bar"><span class="ld-l__t">Pawn tickets</span><span class="ld-sp"></span>
          <label class="ld-sel"><select data-pstat aria-label="Status"><option value="open">Open (active + overdue)</option><option value="all">All</option><option value="Active">Active</option><option value="Overdue">Overdue</option><option value="Redeemed">Redeemed</option></select></label>
        </div>
        <table class="ld-t"><thead><tr><th>Ticket</th><th>Customer</th><th>Items</th><th>Bin</th><th>Due</th><th class="num">Principal</th><th>Status</th></tr></thead><tbody data-prows></tbody></table>
      </div>`;
    function drawPawnFigs(range: string) {
      const f = D.pawnFigs[range];
      $('[data-pfigs]', sp).innerHTML = kpi({
        seg: ['All time', 'Day', 'Week', 'Month'],
        segKey: 'range',
        actions: '<button class="ld-btn" data-soon="Forfeiture review">Forfeiture review</button><button class="ld-btn ld-btn--solid" data-soon="New pawn ticket">New pawn</button>',
        figs: [['Active pawns', f[0]], ['Principal out', f[1]], ['Overdue', f[2], f[2] !== '0' ? 'red' : ''], ['Redeemed', f[3]], ['Forfeited', f[4]]],
      });
      $$('[data-seg="range"] button', sp).forEach((b) => b.classList.toggle('is-on', b.dataset.v === range));
    }
    const drawPawns = (st: string) => {
      const rows = D.pawns.filter((p: any) => (st === 'all' ? true : st === 'open' ? p.s !== 'Redeemed' : p.s === st));
      $('[data-prows]', sp).innerHTML = rows
        .map((p: any) => `<tr><td class="ld-name">${p.t}</td><td>${p.c}</td><td>${p.items}</td><td><span class="ld-bin">${p.bin}</span></td><td class="${p.s === 'Overdue' ? 'ld-red' : ''}">${p.due}</td><td class="num"><b>${money(p.p)}</b></td><td>${chip(p.s)}</td></tr>`)
        .join('');
    };
    drawPawnFigs('All time');
    drawPawns('open');
    $('[data-pstat]', sp).addEventListener('change', (e) => drawPawns((e.target as HTMLSelectElement).value));

    // ---------------------------------------------------------------- Purchases
    $('[data-screen="Purchases"]').innerHTML = `
      ${kpi({ actions: '<button class="ld-btn" data-soon="Scrap gold estimator">Gold estimator</button><button class="ld-btn ld-btn--solid" data-soon="New purchase">New purchase</button>', figs: [['Bought today', '$410.00'], ['This week', '$1,450.00'], ['Items on hold period', '9'], ['Gold spot (per oz)', '$3,684.20']] })}
      <div class="ld-l"><div class="ld-l__bar"><span class="ld-l__t">Recent purchases</span></div>
        <table class="ld-t"><thead><tr><th>Receipt</th><th>Customer</th><th>Items</th><th>Weight</th><th>Date</th><th class="num">Paid</th></tr></thead><tbody>
        ${D.buys.map((b: any) => `<tr><td class="ld-name">${b.r}</td><td>${b.c}</td><td>${b.items}</td><td>${b.w}</td><td>${b.d}</td><td class="num"><b>${money(b.p)}</b></td></tr>`).join('')}
        </tbody></table></div>`;

    // ---------------------------------------------------------------- Layaways
    const sl = $('[data-screen="Layaways"]');
    const drawLay = () => {
      const owing = D.layaways.reduce((s: number, l: any) => s + (l.total - l.paid), 0);
      sl.innerHTML = `
        ${kpi({ actions: '<button class="ld-btn ld-btn--solid" data-lnew>New layaway</button>', figs: [['Open layaways', String(D.layaways.filter((l: any) => l.paid < l.total).length)], ['Balance owing', money(owing)], ['Due this month', '1']] })}
        <div class="ld-l"><div class="ld-l__bar"><span class="ld-l__t">Layaways</span><span class="ld-sp"></span><span class="ld-hint">Take a $100 payment on any row</span></div>
        <table class="ld-t"><thead><tr><th>#</th><th>Customer</th><th>Item</th><th style="width:220px">Paid</th><th>Due</th><th class="num">Action</th></tr></thead><tbody>
        ${D.layaways
          .map((l: any, i: number) => {
            const pct = Math.round((l.paid / l.total) * 100);
            const done = l.paid >= l.total;
            return `<tr><td class="ld-name">${l.n}</td><td>${l.c}</td><td>${l.item}</td><td><div class="ld-prog"><i style="width:${pct}%"></i></div><small>${money(l.paid)} of ${money(l.total)}</small></td><td>${l.due}</td><td class="num">${done ? chip('Paid off') : `<button class="ld-btn ld-btn--sm" data-lpay="${i}">Take $100</button>`}</td></tr>`;
          })
          .join('')}
        </tbody></table></div>`;
    };
    drawLay();
    sl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-lpay]');
      if (b) {
        const l = D.layaways[Number(b.dataset.lpay)];
        const amt = Math.min(100, l.total - l.paid);
        l.paid += amt;
        drawLay();
        bumpTill(amt);
        toast(l.paid >= l.total ? `${money(amt)} taken. <b>${l.n}</b> is paid off and ready for pick-up.` : `${money(amt)} taken on <b>${l.n}</b>. Receipt prints in the app.`);
      }
      if ((e.target as HTMLElement).closest('[data-lnew]')) {
        go('POS');
        toast('Add items, then tick <b>Hold these items</b> to start a layaway.');
      }
    });

    // ---------------------------------------------------------------- POS
    const spos = $('[data-screen="POS"]');
    let cart: any[] = [];
    let tender = 'Cash';
    let hold = false;
    const tillAmt = () => root.querySelector<HTMLElement>('[data-till-amt]');
    let till = 1240;
    function bumpTill(n: number) {
      till += n;
      const el = tillAmt();
      if (!el) return;
      const txt = money(till);
      el.dataset.real = txt;
      if (el.textContent !== '••••') el.textContent = txt;
      el.parentElement?.classList.add('ld-pulse');
      setTimeout(() => el.parentElement?.classList.remove('ld-pulse'), 900);
    }
    const drawPos = (done?: any) => {
      const sub = cart.reduce((s, c) => s + c.p, 0);
      const hst = Math.round(sub * 13) / 100;
      const total = sub + hst;
      spos.innerHTML = done
        ? `<div class="ld-done">
             <div class="ld-card ld-done__main"><span class="ld-ok">✓</span><b>Sale complete · ${money(done.total)}</b><span>${done.tender}${done.tender === 'Cash' ? ' · added to Till 1' : ''}</span><button class="ld-btn ld-btn--solid" data-pdone>Done</button></div>
             <div class="ld-card"><b class="ld-card__t">Pick up</b>${done.items.map((c: any) => `<div class="ld-pick"><span>${c.d}</span><span class="ld-bin">${c.bin}</span></div>`).join('')}</div>
           </div>`
        : `<div class="ld-k ld-k--pos"><div class="ld-k__bar">
             <label class="ld-search ld-search--pos">${ico.search}<input data-pq placeholder="Scan SKU, or search type / brand — try “watch” and press Enter" aria-label="Scan or search" /></label>
             <span class="ld-sp"></span>
             <button class="ld-btn ld-btn--solid" data-pcomplete ${cart.length ? '' : 'disabled'}>${hold ? 'Start layaway' : 'Complete sale'}${cart.length ? ' · ' + money(total) : ''}</button>
           </div>
           <div class="ld-quick">Quick add: ${D.catalog.map((c: any, i: number) => `<button data-padd="${i}">${c.d.split(' ').slice(0, 2).join(' ')}</button>`).join('')}</div></div>
           <div class="ld-pos">
             <div class="ld-card ld-card--flush">
               <div class="ld-card__row"><b>Cart</b><span class="ld-sp"></span><button class="ld-btn ld-btn--sm" data-soon="Attach customer">Attach customer (optional)</button></div>
               <table class="ld-t"><thead><tr><th>Item</th><th>SKU</th><th>Bin</th><th class="num">Price</th><th style="width:40px"></th></tr></thead><tbody>
               ${cart.length ? cart.map((c, i) => `<tr><td class="ld-name">${c.d}</td><td class="ld-dim">${c.sku}</td><td><span class="ld-bin">${c.bin}</span></td><td class="num"><b>${money(c.p)}</b></td><td><button class="ld-x" data-prm="${i}" aria-label="Remove">×</button></td></tr>`).join('') : '<tr><td colspan="5" class="ld-empty">Cart is empty. Search above or use Quick add.</td></tr>'}
               </tbody></table>
               <div class="ld-tot"><div><span>Subtotal</span><b>${money(sub)}</b></div><div><span>HST (ON · 13%)</span><b>${money(hst)}</b></div><div class="ld-tot__g"><span>Grand total</span><b>${money(total)}</b></div></div>
             </div>
             <div class="ld-pos__side">
               <div class="ld-card"><b class="ld-card__t">Tender</b><div class="ld-tender">${['Cash', 'Debit', 'Credit', 'E-Transfer', 'Cheque', 'Split'].map((t) => `<button class="${t === tender ? 'is-on' : ''}" data-ptender="${t}">${t}</button>`).join('')}</div></div>
               <label class="ld-card ld-hold"><b class="ld-card__t">Layaway</b><span class="ld-sp"></span><input type="checkbox" data-phold ${hold ? 'checked' : ''} /> Hold these items</label>
               <div class="ld-note"><i>TILL</i>The cash portion of a sale records a movement against the open till.</div>
             </div>
