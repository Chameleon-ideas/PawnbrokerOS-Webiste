---
<div class="mock hero__win ld" data-ld>
  <BrowserBar url="dashboard.pawnbrokeros.com / customers" padding="12px 16px" dot={11} urlWidth={440} font={12} bg="var(--surface-3)" />
  <AppNav active="Customer" height={64} padding="0 20px" markSize={26} wordSize={15} tabSize={12} />

  <div class="ld__body">
    {tabsBody.map((t) => <section class="ld__screen" data-screen={t} hidden={t !== 'Customer'}></section>)}

    <!-- shop menu, till menu, customer drawer, wizard, toast: positioned over the body -->
    <div class="ld__menu ld__menu--shop" data-shop-menu hidden>
      <button data-soon="Reports">Reports</button>
      <button data-soon="Settings">Settings</button>
      <button data-soon="Staff &amp; roles">Staff &amp; roles</button>
      <hr />
      <button data-soon="Sign out">Sign out</button>
    </div>
    <div class="ld__menu ld__menu--till" data-till-pop hidden>
      <span class="ld__menu-hd">Switch till</span>
      <button class="is-on">✓ Till 1 <i class="ok">Open</i></button>
      <button data-soon="Till 2">Till 2 <i>Closed</i></button>
      <hr />
      <button data-soon="Close till">Close Till 1…</button>
    </div>
    <aside class="ld__drawer" data-drawer hidden></aside>
    <div class="ld__veil" data-veil hidden></div>
    <div class="ld__wiz" data-wiz hidden></div>
    <div class="ld__toast" data-toast hidden></div>
  </div>

  <AppFooter font={12} height={40} />
</div>

<script type="application/json" id="ld-data" set:html={JSON.stringify(data)} />

<script>
  type Cust = { id: string; first: string; last: string; phone: string; loans: number; visit: string; flag: string; email: string; city: string };
  const root = document.querySelector<HTMLElement>('[data-ld]');
  const raw = document.getElementById('ld-data');
  if (root && raw) {
    const D = JSON.parse(raw.textContent || '{}');
    const $ = <T extends Element = HTMLElement>(sel: string, el: ParentNode = root) => el.querySelector(sel) as T;
    const $$ = <T extends Element = HTMLElement>(sel: string, el: ParentNode = root) => Array.from(el.querySelectorAll(sel)) as T[];
    const money = (n: number) => (n < 0 ? '−' : '') + '$' + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const ico = {
      scan: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/></svg>',
      plus: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>',
      search: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>',
      chev: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>',
    };

    // ---------------------------------------------------------------- toast
    let toastT = 0;
    const toast = (html: string) => {
      const t = $('[data-toast]');
      t.innerHTML = html;
      t.hidden = false;
      clearTimeout(toastT);
      toastT = window.setTimeout(() => (t.hidden = true), 3200);
    };
    const soon = (what: string) =>
      toast(`<b>${esc(what)}</b> is in the full app. <a href="#book-demo">Book a demo</a> to see it.`);

    // ---------------------------------------------------------------- navigation
    const urls: Record<string, string> = { Home: '', Customer: 'customers', Pawn: 'pawns', Purchases: 'purchases', Layaways: 'layaways', POS: 'pos', Inventory: 'inventory', Transactions: 'transactions' };
    const urlEl = $$('.mock__url, [class*="url"]').find((e) => /dashboard\.pawnbrokeros\.com/.test(e.textContent || ''));
    const closePops = () => {
      $$('[data-shop-menu],[data-till-pop]').forEach((m) => (m.hidden = true));
    };
    const go = (tab: string) => {
      closePops();
      closeDrawer();
      $$('[data-tab]').forEach((t) => t.classList.toggle('is-active', t.dataset.tab === tab));
      $$('[data-screen]').forEach((s) => (s.hidden = s.dataset.screen !== tab));
      if (urlEl) urlEl.textContent = 'dashboard.pawnbrokeros.com' + (urls[tab] ? ' / ' + urls[tab] : '');
      root.dispatchEvent(new CustomEvent('ld:interact'));
    };
    $$('[data-tab]').forEach((t) => {
      t.setAttribute('role', 'button');
      t.tabIndex = 0;
      t.addEventListener('click', () => go(t.dataset.tab!));
      t.addEventListener('keydown', (e) => (e.key === 'Enter' || e.key === ' ') && (e.preventDefault(), go(t.dataset.tab!)));
    });

    // shop + till menus
    $('[data-shop]').addEventListener('click', (e) => {
      e.stopPropagation();
      const m = $('[data-shop-menu]');
      const was = m.hidden;
      closePops();
      m.hidden = !was;
    });
    $('[data-till-menu]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const m = $('[data-till-pop]');
      const was = m.hidden;
      closePops();
      m.hidden = !was;
    });
    root.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-soon]');
      if (el) {
        closePops();
        soon(el.dataset.soon!);
      } else if (!(e.target as HTMLElement).closest('[data-shop-menu],[data-till-pop]')) closePops();
    });

    // ---------------------------------------------------------------- shared pieces
    const kpi = (opts: { seg?: string[]; segKey?: string; actions?: string; figs: [string, string, string?][] }) => `
      <div class="ld-k">
        <div class="ld-k__bar">
          ${opts.seg ? `<span class="ld-seg" data-seg="${opts.segKey}">${opts.seg.map((s, i) => `<button class="${i === 0 ? 'is-on' : ''}" data-v="${s}">${s}</button>`).join('')}</span>` : ''}
          <span class="ld-sp"></span>${opts.actions || ''}
        </div>
        <div class="ld-k__figs" style="grid-template-columns:repeat(${opts.figs.length},1fr)">
          ${opts.figs.map(([k, v, cls]) => `<div><span>${k}</span><b class="${cls || ''}">${v}</b></div>`).join('')}
        </div>
      </div>`;
    const chip = (t: string) => {
      const c = /do not/i.test(t) ? 'red' : /vip/i.test(t) ? 'amber' : /overdue/i.test(t) ? 'red' : /active|open/i.test(t) ? 'green' : /redeemed/i.test(t) ? 'blue' : 'grey';
      return t ? `<span class="ld-chip ld-chip--${c}">${esc(t)}</span>` : '<span class="ld-dim">—</span>';
    };

    // ---------------------------------------------------------------- Customer
    const custs: Cust[] = D.customers.slice();
    const cs = { seg: 'All', q: '', flag: 'all', page: 0, sel: new Set<string>() };
    const PER = 7;
    const sc = $('[data-screen="Customer"]');
    sc.innerHTML = `
      ${kpi({
        actions: `<button class="ld-btn" data-act="scan">${ico.scan}Scan ID</button><button class="ld-btn ld-btn--solid" data-act="add">${ico.plus}Add new customer</button>`,
        figs: [['Customers', '<span data-cc-total>4,288</span>'], ['With an active pawn', '938'], ['Flagged', '77']],
      })}
      <div class="ld-l">
        <div class="ld-l__bar">
          <span class="ld-seg" data-seg="cust">
            <button class="is-on" data-v="All">All <i>4,288</i></button><button data-v="Active">Active <i>938</i></button><button data-v="Inactive">Inactive <i>3,350</i></button>
          </span>
          <span class="ld-sp"></span>
          <label class="ld-sel"><select data-cflag aria-label="Flag filter"><option value="all">All flags</option><option value="VIP">VIP</option><option value="Repeat">Repeat</option><option value="Do not loan">Do not loan</option><option value="none">No flag</option></select></label>
          <label class="ld-search">${ico.search}<input data-cq placeholder="Name, phone, email, last 4 SIN" aria-label="Search customers" /></label>
        </div>
        <table class="ld-t">
          <thead><tr><th style="width:44px"><input type="checkbox" data-call aria-label="Select all" /></th><th style="width:120px">Customer #</th><th>Name</th><th style="width:150px">Phone</th><th class="num" style="width:110px">Active loans</th><th style="width:110px">Last visit</th><th style="width:140px">Flags</th><th class="num" style="width:90px">Action</th></tr></thead>
          <tbody data-crows></tbody>
        </table>
        <div class="ld-pager"><span data-cinfo></span><span data-cpage></span><span class="ld-pager__b"><button data-cprev>Prev</button><button data-cnext>Next</button></span></div>
      </div>`;
    const filtered = () =>
      custs.filter((c) => {
        if (cs.seg === 'Active' && !c.loans) return false;
        if (cs.seg === 'Inactive' && c.loans) return false;
        if (cs.flag === 'none' && c.flag) return false;
        if (cs.flag !== 'all' && cs.flag !== 'none' && c.flag !== cs.flag) return false;
        if (cs.q) {
          const hay = `${c.first} ${c.last} ${c.last}, ${c.first} ${c.phone} ${c.email} ${c.id}`.toLowerCase();
          if (!hay.includes(cs.q.toLowerCase())) return false;
        }
        return true;
      });
    const drawCusts = () => {
      const list = filtered();
      const pages = Math.max(1, Math.ceil(list.length / PER));
      cs.page = Math.min(cs.page, pages - 1);
      const rows = list.slice(cs.page * PER, cs.page * PER + PER);
      $('[data-crows]', sc).innerHTML = rows.length
        ? rows
            .map(
              (c) => `<tr data-cid="${c.id}" class="${cs.sel.has(c.id) ? 'is-sel' : ''}${c.id.startsWith('NEW') ? ' is-new' : ''}">
                <td><input type="checkbox" data-csel ${cs.sel.has(c.id) ? 'checked' : ''} aria-label="Select ${esc(c.first)}" /></td>
                <td class="ld-dim">${c.id.replace('NEW', '0810')}</td>
                <td class="ld-name">${esc(c.last)}, ${esc(c.first)}</td>
                <td>${c.phone}</td>
                <td class="num"><b>${c.loans || '—'}</b></td>
                <td>${c.visit}</td>
                <td>${chip(c.flag)}</td>
                <td class="num"><button class="ld-open" data-copen>Open${ico.chev}</button></td>
              </tr>`,
            )
            .join('')
        : `<tr><td colspan="8" class="ld-empty">No customers match. Try another name or clear the filters.</td></tr>`;
      $('[data-cinfo]', sc).textContent = `Showing ${rows.length} of ${list.length} sample customers`;
      $('[data-cpage]', sc).textContent = `Page ${cs.page + 1} of ${pages}`;
      $<HTMLButtonElement>('[data-cprev]', sc).disabled = cs.page === 0;
      $<HTMLButtonElement>('[data-cnext]', sc).disabled = cs.page >= pages - 1;
      $<HTMLInputElement>('[data-call]', sc).checked = rows.length > 0 && rows.every((r) => cs.sel.has(r.id));
    };
    $('[data-cq]', sc).addEventListener('input', (e) => {
      cs.q = (e.target as HTMLInputElement).value;
      cs.page = 0;
      drawCusts();
    });
    $('[data-cflag]', sc).addEventListener('change', (e) => {
      cs.flag = (e.target as HTMLSelectElement).value;
      cs.page = 0;
      drawCusts();
    });
    $('[data-cprev]', sc).addEventListener('click', () => (cs.page--, drawCusts()));
    $('[data-cnext]', sc).addEventListener('click', () => (cs.page++, drawCusts()));
    $('[data-call]', sc).addEventListener('change', (e) => {
      const on = (e.target as HTMLInputElement).checked;
      const list = filtered().slice(cs.page * PER, cs.page * PER + PER);
      list.forEach((c) => (on ? cs.sel.add(c.id) : cs.sel.delete(c.id)));
      drawCusts();
    });
    $('[data-crows]', sc).addEventListener('click', (e) => {
      const tr = (e.target as HTMLElement).closest<HTMLElement>('tr[data-cid]');
      if (!tr) return;
      const id = tr.dataset.cid!;
      if ((e.target as HTMLElement).matches('[data-csel]')) {
        cs.sel.has(id) ? cs.sel.delete(id) : cs.sel.add(id);
        drawCusts();
        return;
      }
      openDrawer(custs.find((c) => c.id === id)!);
    });

    // segmented controls (customer + pawn range + inventory origin)
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.ld-seg button');
      if (!b) return;
      const seg = b.parentElement!;
      $$('button', seg).forEach((x) => x.classList.toggle('is-on', x === b));
      const key = seg.dataset.seg;
      const v = b.dataset.v!;
      if (key === 'cust') {
        cs.seg = v;
        cs.page = 0;
        drawCusts();
      } else if (key === 'range') drawPawnFigs(v);
      else if (key === 'origin') drawInv(v);
      else if (key === 'txn') drawTxns(v);
    });

    // ---------------------------------------------------------------- customer drawer
    function closeDrawer() {
      const d = $('[data-drawer]');
      if (d) d.hidden = true;
    }
    function openDrawer(c: Cust) {
      const d = $('[data-drawer]');
      d.innerHTML = `
        <div class="ld-dr__hd"><div><b>${esc(c.last)}, ${esc(c.first)}</b><span>Customer #${c.id.replace('NEW', '0810')}</span></div><button data-drclose aria-label="Close">×</button></div>
        ${c.flag ? `<div class="ld-dr__flag">${chip(c.flag)}</div>` : ''}
        <dl class="ld-dr__dl">
          <div><dt>Phone</dt><dd>${c.phone}</dd></div>
          <div><dt>Email</dt><dd>${esc(c.email)}</dd></div>
          <div><dt>City</dt><dd>${esc(c.city)}</dd></div>
          <div><dt>Active loans</dt><dd>${c.loans || 'None'}</dd></div>
