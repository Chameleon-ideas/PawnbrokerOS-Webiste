      drawPos();
    };
    spos.addEventListener('keydown', (e) => {
      const inp = (e.target as HTMLElement).closest<HTMLInputElement>('[data-pq]');
      if (!inp || e.key !== 'Enter') return;
      const q = inp.value.trim().toLowerCase();
      if (!q) return;
      const hit = D.catalog.find((c: any) => c.sku.toLowerCase() === q || c.d.toLowerCase().includes(q) || c.k.includes(q));
      if (hit) addItem(hit);
      else toast(`No item matches “${esc(inp.value)}”. Try watch, ring, guitar, drill, gold or ps5.`);
    });
    spos.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const add = t.closest<HTMLElement>('[data-padd]');
      if (add) return addItem(D.catalog[Number(add.dataset.padd)]);
      const rm = t.closest<HTMLElement>('[data-prm]');
      if (rm) return (cart.splice(Number(rm.dataset.prm), 1), drawPos());
      const td = t.closest<HTMLElement>('[data-ptender]');
      if (td) return ((tender = td.dataset.ptender!), drawPos());
      if (t.closest('[data-phold]')) return ((hold = (t as HTMLInputElement).checked), drawPos());
      if (t.closest('[data-pdone]')) return drawPos();
      if (t.closest('[data-pcomplete]') && cart.length) {
        const sub = cart.reduce((s, c) => s + c.p, 0);
        const total = sub + Math.round(sub * 13) / 100;
        if (hold) {
          D.layaways.unshift({ n: 'L-119', c: 'Walk-in', item: cart.map((c) => c.d).join(', '), total, paid: 0, due: '02/24/27' });
          cart = [];
          hold = false;
          drawLay();
          go('Layaways');
          return toast('Layaway <b>L-119</b> started. Take the deposit from the Layaways list.');
        }
        const done = { total, tender, items: cart.slice() };
        if (tender === 'Cash') bumpTill(total);
        D.inventory = D.inventory.filter((i: any) => !cart.some((c) => c.sku === i.sku));
        D.catalog = D.catalog.filter((i: any) => !cart.some((c) => c.sku === i.sku));
        D.txns.push({ t: new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }), type: 'Sale', ref: 'S-10423', who: 'Walk-in', amt: total });
        cart = [];
        drawPos(done);
        drawInv('All');
        drawTxns('All');
      }
    });
    drawPos();

    // ---------------------------------------------------------------- Inventory
    const sinv = $('[data-screen="Inventory"]');
    sinv.innerHTML = `
      ${kpi({ actions: '<button class="ld-btn" data-soon="Export">Export</button><button class="ld-btn" data-soon="Bulk edit">Bulk edit</button><button class="ld-btn ld-btn--solid" data-soon="Add item">+ Add item</button>', figs: [['Total items', '1,842'], ['Forfeited pawns', '623'], ['Purchased', '891'], ['Direct stock', '328']] })}
      <div class="ld-l"><div class="ld-l__bar">
        <span class="ld-seg" data-seg="origin"><button class="is-on" data-v="All">All</button><button data-v="Forfeit">Forfeited</button><button data-v="Purchase">Purchased</button><button data-v="Direct">Direct</button></span>
        <span class="ld-sp"></span><span class="ld-hint">Every item knows where it came from and where it sits</span></div>
        <table class="ld-t"><thead><tr><th>SKU</th><th>Item</th><th>Category</th><th>Bin</th><th>Origin</th><th class="num">Price</th></tr></thead><tbody data-irows></tbody></table></div>`;
    function drawInv(o: string) {
      $$('[data-seg="origin"] button', sinv).forEach((b) => b.classList.toggle('is-on', b.dataset.v === o));
      $('[data-irows]', sinv).innerHTML = D.inventory
        .filter((i: any) => o === 'All' || i.o === o)
        .map((i: any) => `<tr><td class="ld-dim">${i.sku}</td><td class="ld-name">${i.d}</td><td>${i.cat}</td><td><span class="ld-bin">${i.bin}</span></td><td>${chip(i.o)}</td><td class="num"><b>${money(i.p)}</b></td></tr>`)
        .join('');
    }
    drawInv('All');

    // ---------------------------------------------------------------- Transactions
    const stx = $('[data-screen="Transactions"]');
    stx.innerHTML = `
      <div class="ld-l"><div class="ld-l__bar">
        <span class="ld-seg" data-seg="txn"><button class="is-on" data-v="All">All</button><button data-v="in">Money in</button><button data-v="out">Money out</button></span>
        <span class="ld-sp"></span><span class="ld-hint">Today · every movement is logged against the till</span></div>
        <table class="ld-t"><thead><tr><th>Time</th><th>Type</th><th>Reference</th><th>Customer</th><th class="num">Amount</th></tr></thead><tbody data-trows></tbody></table></div>`;
    function drawTxns(f: string) {
      $$('[data-seg="txn"] button', stx).forEach((b) => b.classList.toggle('is-on', b.dataset.v === f));
      $('[data-trows]', stx).innerHTML = D.txns
        .filter((t: any) => f === 'All' || (f === 'in' ? t.amt > 0 : t.amt < 0))
        .map((t: any) => `<tr><td class="ld-dim">${t.t}</td><td class="ld-name">${t.type}</td><td>${t.ref}</td><td>${t.who}</td><td class="num"><b class="${t.amt < 0 ? 'ld-red' : 'ld-green'}">${money(t.amt)}</b></td></tr>`)
        .join('');
    }
    drawTxns('All');

    drawCusts();
    root.classList.add('is-live');

    // Esc closes whatever is open in the demo.
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      closeWiz();
      closeDrawer();
      closePops();
    });
  }
</script>

