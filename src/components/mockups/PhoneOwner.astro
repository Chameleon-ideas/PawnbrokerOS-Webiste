---
/**
 * The owner's mobile app, Today screen (owner, 2026-11-24), shown beside the web preview in
 * the hero. Rebuilt in HTML from the app's real layout — net-cash card, the book, inventory,
 * bottom tabs — with sample figures (no real account data). The date and greeting follow the
 * visitor's clock.
 */
const today = [
  ['Loans written', '3', '$835.00'],
  ['Payments taken', '6', '$412.00'],
  ['Sales', '2', '$1,131.13'],
];
---
<div class="ph" aria-label="PawnbrokerOS owner app on a phone">
  <div class="ph__screen">
    <div class="ph__status">
      <b data-ph-time>10:02</b>
      <span class="ph__island"></span>
      <span class="ph__icons">
        <svg width="16" height="11" viewBox="0 0 16 11" aria-hidden="true"><rect x="0" y="7" width="3" height="4" rx="1" fill="currentColor"/><rect x="4.3" y="5" width="3" height="6" rx="1" fill="currentColor"/><rect x="8.6" y="2.5" width="3" height="8.5" rx="1" fill="currentColor"/><rect x="12.9" y="0" width="3" height="11" rx="1" fill="currentColor" opacity=".35"/></svg>
        <svg width="15" height="11" viewBox="0 0 24 18" aria-hidden="true"><path d="M12 17.5 15.3 13a5.5 5.5 0 0 0-6.6 0Zm-6-6.2 2 2.7a8 8 0 0 1 8 0l2-2.7a11.3 11.3 0 0 0-12 0ZM2.3 6.3l2 2.7a14.5 14.5 0 0 1 15.4 0l2-2.7a18 18 0 0 0-19.4 0Z" fill="currentColor"/></svg>
        <span class="ph__batt"><i></i></span>
      </span>
    </div>

    <div class="ph__body">
      <p class="ph__date" data-ph-date>Tuesday 24 November</p>
      <h4 class="ph__hello" data-ph-hello>Good evening</h4>
      <p class="ph__who">Your shop · Owner</p>

      <h5 class="ph__sec">Today</h5>
      <div class="ph__card">
        <div class="ph__net">
          <div class="ph__net-top"><span>Net cash</span><em>Took in</em></div>
          <b>$1,284.50</b>
          <i class="ph__rule"></i>
          <small>Up $212.40 on yesterday</small>
        </div>
        <div class="ph__rows">
          {today.map(([k, n, v]) => (
            <div><span>{k}</span><b>{n}</b><em>{v}</em></div>
          ))}
        </div>
      </div>

      <h5 class="ph__sec">The book</h5>
      <div class="ph__pair">
        <div class="ph__tile"><span>Active pawns</span><b>938</b><em>$214,560.00</em></div>
        <div class="ph__tile"><span>Overdue</span><b class="red">41</b><em>$9,870.00</em></div>
      </div>
      <div class="ph__line"><span>Buys outright</span><b>12</b><em>$4,431.00</em><i>›</i></div>

      <h5 class="ph__sec">Inventory</h5>
      <div class="ph__line ph__line--inv"><div><span>On hand</span><b>1,842</b></div><div><span>Retail value</span><b>$386,240</b></div><i>›</i></div>
    </div>

    <nav class="ph__tabs" aria-hidden="true">
      <span class="is-on"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="10" rx="1"/><rect x="13" y="3" width="8" height="6" rx="1"/><rect x="13" y="11" width="8" height="10" rx="1"/><rect x="3" y="15" width="8" height="6" rx="1"/></svg>Today</span>
      <span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6M9 12h6"/></svg>Transactions</span>
      <span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8.5" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><path d="M3 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5M13.5 14.2c.8-.2 1.6-.2 2.5-.2 3 0 5 2 5 5"/></svg>Customers</span>
      <span><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>More</span>
    </nav>
  </div>
</div>

<script>
  // Date, greeting and status-bar clock follow the visitor's own clock.
  const setPhone = () => {
    const now = new Date();
    const h = now.getHours();
    const date = now.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
    const time = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }).replace(/\s?[AP]M/, '');
    const hello = h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
    document.querySelectorAll('[data-ph-date]').forEach((e) => (e.textContent = date.replace(',', '')));
    document.querySelectorAll('[data-ph-time]').forEach((e) => (e.textContent = time));
    document.querySelectorAll('[data-ph-hello]').forEach((e) => (e.textContent = hello));
  };
  setPhone();
  setInterval(setPhone, 30000);
</script>

<style>
  .ph {
    width: 300px;
    padding: 10px;
    border-radius: 48px;
    background: #14152a;
    box-shadow: 0 0 0 1.5px #3a3b55 inset, 0 40px 70px -24px rgb(30 27 75 / 0.55), 0 12px 24px -12px rgb(30 27 75 / 0.35);
  }
  .ph__screen {
    position: relative;
    height: 620px;
    border-radius: 39px;
    overflow: hidden;
    background: #f4f5f9;
    color: #0f1222;
    font-family: var(--sans);
    display: flex;
    flex-direction: column;
  }
  .ph__status { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 14px 24px 6px; font-size: 13px; }
  .ph__status b { font-weight: 700; }
  .ph__island { position: absolute; left: 50%; top: 10px; transform: translateX(-50%); width: 92px; height: 26px; border-radius: 99px; background: #0b0b14; }
  .ph__icons { display: flex; align-items: center; gap: 5px; }
  .ph__batt { position: relative; width: 23px; height: 11px; border: 1.5px solid currentColor; border-radius: 3.5px; opacity: .9; }
  .ph__batt i { position: absolute; inset: 1.5px; right: 5px; border-radius: 1.5px; background: currentColor; }

  .ph__body { flex: 1; overflow: hidden; padding: 10px 16px 0; }
  .ph__date { margin: 4px 0 0; font-size: 12.5px; color: #6b6f85; }
  .ph__hello { margin: 2px 0 0; font-family: var(--sans); font-size: 28px; font-weight: 800; letter-spacing: -0.8px; line-height: 1.15; color: #0f1222; }
  .ph__who { margin: 4px 0 0; font-size: 11.5px; color: #9a9db0; }
  .ph__sec { display: flex; align-items: center; gap: 8px; margin: 16px 0 8px; font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #0f1222; }
  .ph__sec::before { content: ''; width: 3px; height: 13px; border-radius: 2px; background: #b88a3e; }

  .ph__card { border-radius: 18px; overflow: hidden; background: #fff; box-shadow: 0 6px 16px -10px rgb(15 18 34 / 0.25); }
  .ph__net { padding: 14px 16px 12px; background: linear-gradient(160deg, #262a45, #14162a); color: #fff; }
  .ph__net-top { display: flex; align-items: center; justify-content: space-between; }
  .ph__net-top span { font-size: 10.5px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #c9a25c; }
  .ph__net-top em { font-style: normal; font-size: 10px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; padding: 3px 9px; border-radius: 99px; background: rgb(255 255 255 / 0.1); color: #6ee7b7; }
  .ph__net b { display: block; margin-top: 4px; font-size: 30px; font-weight: 800; letter-spacing: -0.6px; color: #6ee7b7; }
  .ph__rule { display: block; height: 2px; margin: 8px 0 6px; border-radius: 2px; background: linear-gradient(90deg, #b88a3e, rgb(184 138 62 / 0)); }
  .ph__net small { font-size: 11.5px; color: #a7abc3; }
  .ph__rows { padding: 8px 16px 10px; }
  .ph__rows div { display: grid; grid-template-columns: 1fr 28px 84px; align-items: center; padding: 4px 0; font-size: 13px; }
  .ph__rows b { font-weight: 700; text-align: center; }
  .ph__rows em { font-style: normal; text-align: right; color: #6b6f85; }

  .ph__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .ph__tile, .ph__line { border-radius: 16px; background: #fff; box-shadow: 0 6px 16px -10px rgb(15 18 34 / 0.25); }
  .ph__tile { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; }
  .ph__tile span { font-size: 10px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; color: #6b6f85; }
  .ph__tile b { font-size: 22px; font-weight: 800; }
  .ph__tile b.red { color: #dc2626; }
  .ph__tile em { font-style: normal; font-size: 11.5px; font-weight: 600; color: #6b6f85; }
  .ph__line { display: flex; align-items: center; gap: 8px; margin-top: 8px; padding: 12px 14px; font-size: 13.5px; }
  .ph__line > span { flex: 1; }
  .ph__line b { font-weight: 700; }
  .ph__line em { font-style: normal; color: #6b6f85; }
  .ph__line i { font-style: normal; font-size: 18px; color: #b5b8c8; }
  .ph__line--inv { margin-top: 0; }
  .ph__line--inv div { flex: 1; display: flex; flex-direction: column; }
  .ph__line--inv div span { font-size: 11.5px; color: #6b6f85; }
  .ph__line--inv div b { font-size: 18px; font-weight: 800; }

  .ph__tabs { display: grid; grid-template-columns: repeat(4, 1fr); padding: 8px 6px 20px; border-top: 1px solid #e4e6ee; background: rgb(255 255 255 / 0.92); }
  .ph__tabs span { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 10px; font-weight: 600; color: #9a9db0; }
  .ph__tabs span.is-on { color: #14162a; }
</style>
