---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Capabilities from '../components/Capabilities.astro';
import PawnLoanShowcase from '../components/PawnLoanShowcase.astro';
import CustomerShowcase from '../components/CustomerShowcase.astro';
import InventorySection from '../components/InventorySection.astro';
import CashControl from '../components/CashControl.astro';
import Reporting from '../components/Reporting.astro';
import FAQSection from '../components/FAQSection.astro';
import DataProtection from '../components/DataProtection.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <PawnLoanShowcase />
    <Capabilities />
    <HowItWorks />
    <CustomerShowcase />
    <InventorySection />
    <CashControl />
    <Reporting />
    <FAQSection />
    <DataProtection />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
